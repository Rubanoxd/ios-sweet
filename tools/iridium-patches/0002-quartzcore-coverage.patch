+// The air.* library functions: air.[fast_|precise_]NAME.TYPES -> GLSL.std.450
+// or core instructions. Returns ResultIDInvalid for an unknown name.
+static Iridium::SPIRV::ResultID sweetAirCall(Iridium::SPIRV::Builder& builder, std::string_view name, LLVMValueRef inst, Iridium::SPIRV::ResultID type, LLVMTypeRef llvmType) {
+	using namespace Iridium::SPIRV;
+	if (name.substr(0, 4) != "air.") {
+		return ResultIDInvalid;
+	}
+	auto n = name.substr(4);
+	for (std::string_view prefix: { "fast_", "precise_" }) {
+		if (n.substr(0, prefix.size()) == prefix) {
+			n = n.substr(prefix.size());
+		}
+	}
+	auto dot = n.find('.');
+	auto op = n.substr(0, dot);
+	auto rest = dot == std::string_view::npos ? std::string_view() : n.substr(dot + 1);
+	bool isSigned = rest.substr(0, 2) == "s.";
+	bool isUnsigned = rest.substr(0, 2) == "u.";
+	unsigned count = DynamicLLVM::LLVMGetNumArgOperands(inst);
+	std::vector<ResultID> args;
+	for (unsigned i = 0; i < count; ++i) {
+		args.push_back(llvmValueToResultID(builder, DynamicLLVM::LLVMGetOperand(inst, i)));
+	}
+	struct Entry { std::string_view name; GLSLOpcode op; unsigned args; };
+	static const Entry floats[] = {
+		{ "floor", GLSLOpcode::Floor, 1 }, { "ceil", GLSLOpcode::Ceil, 1 }, { "trunc", GLSLOpcode::Trunc, 1 },
+		{ "rint", GLSLOpcode::RoundEven, 1 }, { "round", GLSLOpcode::Round, 1 }, { "fract", GLSLOpcode::Fract, 1 },
+		{ "fabs", GLSLOpcode::FAbs, 1 }, { "sqrt", GLSLOpcode::Sqrt, 1 }, { "rsqrt", GLSLOpcode::InverseSqrt, 1 },
+		{ "sin", GLSLOpcode::Sin, 1 }, { "cos", GLSLOpcode::Cos, 1 }, { "tan", GLSLOpcode::Tan, 1 },
+		{ "asin", GLSLOpcode::Asin, 1 }, { "acos", GLSLOpcode::Acos, 1 }, { "atan", GLSLOpcode::Atan, 1 },
+		{ "atan2", GLSLOpcode::Atan2, 2 }, { "sinh", GLSLOpcode::Sinh, 1 }, { "cosh", GLSLOpcode::Cosh, 1 },
+		{ "tanh", GLSLOpcode::Tanh, 1 }, { "pow", GLSLOpcode::Pow, 2 }, { "powr", GLSLOpcode::Pow, 2 },
+		{ "exp", GLSLOpcode::Exp, 1 }, { "exp2", GLSLOpcode::Exp2, 1 }, { "log", GLSLOpcode::Log, 1 },
+		{ "log2", GLSLOpcode::Log2, 1 }, { "fmin", GLSLOpcode::FMin, 2 }, { "fmax", GLSLOpcode::FMax, 2 },
+		{ "fma", GLSLOpcode::Fma, 3 }, { "fclamp", GLSLOpcode::FClamp, 3 }, { "mix", GLSLOpcode::FMix, 3 },
+		{ "step", GLSLOpcode::Step, 2 }, { "smoothstep", GLSLOpcode::SmoothStep, 3 }, { "sign", GLSLOpcode::FSign, 1 },
+		{ "length", GLSLOpcode::Length, 1 }, { "distance", GLSLOpcode::Distance, 2 },
+		{ "normalize", GLSLOpcode::Normalize, 1 }, { "cross", GLSLOpcode::Cross, 2 },
+		{ "reflect", GLSLOpcode::Reflect, 2 },
+	};
+	if (isSigned || isUnsigned) {
+		if (op == "min" && count == 2) {
+			return builder.encodeGLSL(isSigned ? GLSLOpcode::SMin : GLSLOpcode::UMin, type, args);
+		} else if (op == "max" && count == 2) {
+			return builder.encodeGLSL(isSigned ? GLSLOpcode::SMax : GLSLOpcode::UMax, type, args);
+		} else if (op == "clamp" && count == 3) {
+			return builder.encodeGLSL(isSigned ? GLSLOpcode::SClamp : GLSLOpcode::UClamp, type, args);
+		} else if (op == "abs" && count == 1) {
+			return isSigned ? builder.encodeGLSL(GLSLOpcode::SAbs, type, args) : args[0];
+		}
+	}
+	if (op == "clamp" && count == 3 && sweetIsFloat(llvmType)) {
+		return builder.encodeGLSL(GLSLOpcode::FClamp, type, args);
+	}
+	if (op == "min" && count == 2 && sweetIsFloat(llvmType)) {
+		return builder.encodeGLSL(GLSLOpcode::FMin, type, args);
+	}
+	if (op == "max" && count == 2 && sweetIsFloat(llvmType)) {
+		return builder.encodeGLSL(GLSLOpcode::FMax, type, args);
+	}
+	if (op == "saturate" && count == 1) {
+		return builder.encodeGLSL(GLSLOpcode::FClamp, type, { args[0], sweetConstLike(builder, llvmType, 0), sweetConstLike(builder, llvmType, 1) });
+	}
+	if (op == "dot" && count == 2) {
+		return builder.encodeArithBinop(Opcode::Dot, type, args[0], args[1]);
+	}
+	if (op == "convert" && count == 1) {
+		// air.convert.DST.DSTTYPE.SRC.SRCTYPE, kinds f, u, s
+		auto d = rest.substr(0, 1);
+		auto srcPos = rest.find('.', rest.find('.') + 1);
+		auto src = srcPos == std::string_view::npos ? std::string_view() : rest.substr(srcPos + 1, 1);
+		auto srcType = DynamicLLVM::LLVMTypeOf(DynamicLLVM::LLVMGetOperand(inst, 0));
+		if (srcType == llvmType) {
+			return builder.encodeOp(Opcode::CopyObject, type, { args[0] });
+		}
+		if (sweetIsBool(srcType)) {
+			return builder.encodeOp(Opcode::Select, type, { args[0], sweetConstLike(builder, llvmType, 1), sweetConstLike(builder, llvmType, 0) });
+		}
+		if (d == "f" && src == "f") {
+			return builder.encodeFConvert(type, args[0]);
+		} else if (d == "f" && src == "u") {
+			return builder.encodeOp(Opcode::ConvertUToF, type, { args[0] });
+		} else if (d == "f" && src == "s") {
+			return builder.encodeOp(Opcode::ConvertSToF, type, { args[0] });
+		} else if (d == "u" && src == "f") {
+			return builder.encodeOp(Opcode::ConvertFToU, type, { args[0] });
+		} else if (d == "s" && src == "f") {
+			return builder.encodeOp(Opcode::ConvertFToS, type, { args[0] });
+		} else if ((d == "u" || d == "s") && (src == "s" || src == "u")) {
+			// same width (int <-> uint): a bitcast
+			auto width = [](LLVMTypeRef t) {
+				if (DynamicLLVM::LLVMGetTypeKind(t) == LLVMVectorTypeKind) {
+					t = DynamicLLVM::LLVMGetElementType(t);
+				}
+				return DynamicLLVM::LLVMGetIntTypeWidth(t);
+			};
+			if (width(srcType) == width(llvmType)) {
+				return builder.encodeBitcast(type, args[0]);
+			}
+			return builder.encodeOp(src == "s" ? Opcode::SConvert : Opcode::UConvert, type, { args[0] });
+		}
+		return ResultIDInvalid;
+	}
+	for (auto& e: floats) {
+		if (op == e.name && count == e.args) {
+			return builder.encodeGLSL(e.op, type, args);
+		}
+	}
+	return ResultIDInvalid;
+}
