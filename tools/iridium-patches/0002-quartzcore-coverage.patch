+// SWEET helpers -----------------------------------------------------------
+
+// The bool type with the shape of LLVMTYPE (scalar or vector).
+static Iridium::SPIRV::ResultID sweetBoolLike(Iridium::SPIRV::Builder& builder, LLVMTypeRef llvmType) {
+	using namespace Iridium::SPIRV;
+	auto boolType = builder.declareType(Type(Type::BooleanTag {}));
+	if (DynamicLLVM::LLVMGetTypeKind(llvmType) == LLVMVectorTypeKind) {
+		auto n = DynamicLLVM::LLVMGetVectorSize(llvmType);
+		return builder.declareType(Type(Type::VectorTag {}, n, boolType, n, n));
+	}
+	return boolType;
+}
+
+// A constant VALUE of LLVMTYPE's element type, splatted when it is a vector.
+static Iridium::SPIRV::ResultID sweetConstLike(Iridium::SPIRV::Builder& builder, LLVMTypeRef llvmType, double value) {
+	using namespace Iridium::SPIRV;
+	bool vector = DynamicLLVM::LLVMGetTypeKind(llvmType) == LLVMVectorTypeKind;
+	LLVMTypeRef elem = vector ? DynamicLLVM::LLVMGetElementType(llvmType) : llvmType;
+	ResultID scalar;
+	switch (DynamicLLVM::LLVMGetTypeKind(elem)) {
+		case LLVMFloatTypeKind:
+			scalar = builder.declareConstantScalar<float>(static_cast<float>(value));
+			break;
+		case LLVMHalfTypeKind: {
+			Iridium::Float16 tmp = static_cast<float>(value);
+			scalar = builder.declareConstantScalar<const Iridium::Float16*>(&tmp);
+		} break;
+		case LLVMIntegerTypeKind: {
+			auto width = DynamicLLVM::LLVMGetIntTypeWidth(elem);
+			auto v = static_cast<int64_t>(value);
+			if (width == 1) {
+				scalar = builder.declareConstantBool(v != 0);
+			} else if (width == 8) {
+				scalar = builder.declareConstantScalar<int8_t>(static_cast<int8_t>(v));
+			} else if (width == 16) {
+				scalar = builder.declareConstantScalar<int16_t>(static_cast<int16_t>(v));
+			} else if (width == 32) {
+				scalar = builder.declareConstantScalar<int32_t>(static_cast<int32_t>(v));
+			} else {
+				scalar = builder.declareConstantScalar<int64_t>(v);
+			}
+		} break;
+		default:
+			throw std::runtime_error("SWEET: no constants of this type");
+	}
+	if (!vector) {
+		return scalar;
+	}
+	std::vector<ResultID> elements(DynamicLLVM::LLVMGetVectorSize(llvmType), scalar);
+	return builder.declareConstantComposite(llvmTypeToSPIRVType(builder, llvmType), elements);
+}
+
+static bool sweetIsBool(LLVMTypeRef llvmType) {
+	if (DynamicLLVM::LLVMGetTypeKind(llvmType) == LLVMVectorTypeKind) {
+		llvmType = DynamicLLVM::LLVMGetElementType(llvmType);
+	}
+	return DynamicLLVM::LLVMGetTypeKind(llvmType) == LLVMIntegerTypeKind && DynamicLLVM::LLVMGetIntTypeWidth(llvmType) == 1;
+}
+
+static bool sweetIsFloat(LLVMTypeRef llvmType) {
+	if (DynamicLLVM::LLVMGetTypeKind(llvmType) == LLVMVectorTypeKind) {
+		llvmType = DynamicLLVM::LLVMGetElementType(llvmType);
+	}
+	auto kind = DynamicLLVM::LLVMGetTypeKind(llvmType);
+	return kind == LLVMFloatTypeKind || kind == LLVMHalfTypeKind || kind == LLVMDoubleTypeKind;
+}
