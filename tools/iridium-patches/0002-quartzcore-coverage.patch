+// SWEET: any core instruction with a result, and any GLSL.std.450 one
+Iridium::SPIRV::ResultID Iridium::SPIRV::Builder::encodeOp(Opcode op, ResultID resultTypeID, std::vector<ResultID> operands) {
+	auto result = reserveResultID();
+	auto tmp = beginInstruction(op, *_currentFunctionWriter);
+	_currentFunctionWriter->writeIntegerLE<uint32_t>(resultTypeID);
+	_currentFunctionWriter->writeIntegerLE<uint32_t>(result);
+	for (auto operand: operands) {
+		_currentFunctionWriter->writeIntegerLE<uint32_t>(operand);
+	}
+	endInstruction(std::move(tmp));
+	return result;
+};
