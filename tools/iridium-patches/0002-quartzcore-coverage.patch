+Iridium::SPIRV::ResultID Iridium::SPIRV::Builder::encodeGLSL(GLSLOpcode op, ResultID resultTypeID, std::vector<ResultID> operands) {
+	auto result = reserveResultID();
+	auto tmp = beginGLSLInstruction(op, *_currentFunctionWriter, resultTypeID, result);
+	for (auto operand: operands) {
+		_currentFunctionWriter->writeIntegerLE<uint32_t>(operand);
+	}
+	endInstruction(std::move(tmp));
+	return result;
+};
