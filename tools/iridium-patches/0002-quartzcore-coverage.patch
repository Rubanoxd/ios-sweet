+// SWEET: OpConstantTrue/OpConstantFalse, cached like the other scalars
+Iridium::SPIRV::ResultID Iridium::SPIRV::Builder::declareConstantBool(bool value) {
+	auto typeID = declareType(Type(Type::BooleanTag {}));
+	auto key = std::make_pair(static_cast<uintmax_t>(value), typeID);
+	auto it = _constantScalars.find(key);
+	if (it != _constantScalars.end()) {
+		return it->second;
+	}
+	auto id = reserveResultID();
+	_constantScalars.emplace(key, id);
+	auto tmp = beginInstruction(value ? Opcode::ConstantTrue : Opcode::ConstantFalse, _constants);
+	_constants.writeIntegerLE<uint32_t>(typeID);
+	_constants.writeIntegerLE<uint32_t>(id);
+	endInstruction(std::move(tmp));
+	return id;
 };
 
