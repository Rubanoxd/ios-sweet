+	static uint64_t next, period;
+	if (period == 0) {
+		nanoseconds_to_absolutetime((uint64_t)SWEET_FB_VSYNC_US * 1000, &period);
+	}
+	next = (next == 0 || next + period <= now) ? now + period : next + period;
+	sender->wakeAtTime(next);
 	uint64_t values[6] = {
 		(uint32_t)count, (uint32_t)(count >> 32),
 		(uint32_t)now, (uint32_t)(now >> 32),
@@ -254,7 +266,6 @@
 				}
 			}
 		}
-		sender->setTimeoutUS(SWEET_FB_VSYNC_US);
 		return;
 	}
 	/* A zero-copy flip costs a cache clean, not a 10 MB copy: every vsync. */
@@ -269,10 +280,22 @@
 	}
 	IOLockUnlock(fb->fLock);
 	if (rec != NULL) {
+		uint64_t began = mach_absolute_time();
 		fb->present(rec);
