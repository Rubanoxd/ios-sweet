--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -223,6 +223,18 @@
 	AppleCLCD *fb = (AppleCLCD *)owner;
 	uint64_t now = mach_absolute_time();
 	uint64_t count = ++fb->fVsyncCount;
+	/*
+	 * xnu 0105: the next vsync is armed first, at an absolute deadline one
+	 * period after this one's. It used to be armed after the work below, so
+	 * a zero-copy flip's 11 MB cache clean stretched every period: with the
+	 * render server on the GPU, QuartzCore paced itself at 24 Hz.
