     unsigned max);
 int sweet_rpmh_arc_vote(const char *res, unsigned hlvl);
+int sweet_rpmh_bcm_vote(const char *const *res, const uint32_t *x, const uint32_t *y, unsigned n);
 
 /* Live downstream DT has two positional reg entries, no reg-names. */
 #define RH_RSC_PA       0x18220000u
@@ -471,6 +472,51 @@
 out:
 	if (error) {
 		printf("SWEET RPMH: %s level %u vote failed errno=%d\n", res, hlvl, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+/*
+ * ACTIVE votes for N bus clock managers (cmd-db slave 5) in one request:
+ * Linux's BCM_TCS_CMD with commit and valid set, average (x) and peak (y)
+ * in the BCM's units, each 14 bits. Used to give the GPU DDR bandwidth
+ * (sweet_ddr.c): on sc7180/atoll the CPU votes it (dev_pm_opp_set_bw), not
+ * the A618's legacy GMU.
+ */
+int
+sweet_rpmh_bcm_vote(const char *const *res, const uint32_t *x, const uint32_t *y, unsigned n)
+{
+	if (!res || !x || !y || n == 0 || n > 4) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	uint32_t addrs[4], values[4];
+	int error = EIO;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	for (unsigned i = 0; !error && i < n; ++i) {
+		unsigned slave = 0;
+		uint32_t off = 0, len = 0;
+		error = rh_find(res[i], &slave, &addrs[i], &off, &len);
+		if (!error && slave != 5) {
+			error = EINVAL;
+		}
+		if (!error) {
+			values[i] = (1u << 30) | (1u << 29) | ((x[i] & 0x3fffu) << 14) | (y[i] & 0x3fffu);
+			printf("SWEET RPMH: BCM %s at %#x aux %u bytes, vote x %u y %u\n", res[i], addrs[i], len, x[i], y[i]);
+		}
+	}
+	if (!error) {
+		error = rh_send_cmds(addrs, values, n, "bcm");
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: BCM vote failed errno=%d\n", error);
 	}
 	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
 	return error;
