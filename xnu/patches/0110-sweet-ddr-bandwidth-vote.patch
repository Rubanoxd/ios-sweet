--- /dev/null
+++ b/bsd/dev/sweet_ddr.c
@@ -0,0 +1,44 @@
+/*
+ * sweet_ddr.c (xnu 0110): kern.sweet_ddr=1 votes the most DDR bandwidth the
+ * bus clock managers give (MC0: DDR, SH0: the memory NoC, ACV: the apps
+ * enable bit), as Linux's interconnect does for the A618 at its top OPP.
+ * Without a vote from us the DDR runs at whatever others ask, and full-screen
+ * GPU passes (QuartzCore's blurs) took 35-60 ms a frame. One way: it only
+ * raises; 0 is refused rather than leaving the DDR without our vote.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+extern int sweet_rpmh_bcm_vote(const char *const *res, const uint32_t *x, const uint32_t *y, unsigned n);
+
+static int sweet_ddr_level;
+
+static int
+sysctl_sweet_ddr SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int v = sweet_ddr_level;
+	int error = sysctl_handle_int(oidp, &v, 0, req);
+	if (error || req->newptr == USER_ADDR_NULL) {
+		return error;
+	}
+	if (v != 1) {
+		return EINVAL;
+	}
+	static const char *const res[3] = {"MC0", "SH0", "ACV"};
+	static const uint32_t x[3] = {0x3fff, 0x3fff, 0};
+	static const uint32_t y[3] = {0x3fff, 0x3fff, 0x8};   /* ACV: the APPS enable bit */
+	error = sweet_rpmh_bcm_vote(res, x, y, 3);
+	if (!error) {
+		sweet_ddr_level = 1;
+	}
+	return error;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_ddr, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    NULL, 0, sysctl_sweet_ddr, "I", "1: vote the most DDR bandwidth (MC0, SH0, ACV)");
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
--- a/bsd/dev/sweet_rpmh.c
