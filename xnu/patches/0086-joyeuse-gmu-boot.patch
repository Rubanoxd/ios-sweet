+/* Stage 4: GMU firmware boot. */
+
+static int
+gpu_load_file(const char *path, uint8_t **out, size_t *out_len)
+{
+	vfs_context_t ctx = vfs_context_create(NULL);
+	vnode_t vp = NULLVP;
+	off_t size = 0;
+	int resid = 0;
+	uint8_t *buf = NULL;
+	int err = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (!err) {
+		err = vnode_size(vp, &size, ctx);
+		if (!err && (size < 64 || size > (off_t)GMU_FW_MAX || (size & 3))) {
+			err = EFBIG;
+		}
+		if (!err) {
+			buf = kalloc_data((vm_size_t)size, Z_WAITOK);
+			err = buf ? 0 : ENOMEM;
+		}
+		if (!err) {
+			err = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)size, 0, UIO_SYSSPACE, 0,
+			    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+			if (!err && resid) {
+				err = EIO;
+			}
+		}
+		(void)vnode_close(vp, FREAD, ctx);
+	}
+	(void)vfs_context_rele(ctx);
+	if (err) {
+		if (buf) {
+			kfree_data(buf, (vm_size_t)size);
+		}
+		gpu_log("cannot read %s: %d", path, err);
+		return err;
+	}
+	*out = buf;
+	*out_len = (size_t)size;
+	return 0;
+}
