+static void
+gpu_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static void
+gpu_set(vm_offset_t base, uint32_t off, uint32_t bits)
+{
+	gpu_wr(base, off, gpu_rd(base, off) | bits);
+}
+
+/* Poll until (reg & mask) == want, for up to us microseconds. */
 static bool
+gpu_wait(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want, unsigned us)
+{
+	for (unsigned i = 0; i <= us; ++i) {
+		if ((gpu_rd(base, off) & mask) == want) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
