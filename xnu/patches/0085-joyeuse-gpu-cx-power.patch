+/* Stage 1: what ABL leaves. Returns false when GPUCC cannot be read. */
+static bool
+gpu_stage_read(void)
+{
+	uint32_t vote = gpu_rd(sg.gcc, GCC_GPU_VOTE);
+	uint32_t ahb = gpu_rd(sg.gcc, GCC_GPU_CFG_AHB), axi = gpu_rd(sg.gcc, GCC_DDRSS_GPU_AXI);
+	uint32_t memnoc = gpu_rd(sg.gcc, GCC_GPU_MEMNOC), dvm = gpu_rd(sg.gcc, GCC_GPU_SNOC_DVM);
+	gpu_log("gcc vote 0x%08x (gpll0 %s, div %s) cfg_ahb 0x%08x (%s) ddrss_axi 0x%08x (%s) "
+	    "memnoc_gfx 0x%08x (%s) snoc_dvm 0x%08x (%s)",
+	    vote, onoff(vote, GCC_GPU_GPLL0), onoff(vote, GCC_GPU_GPLL0_DIV),
+	    ahb, clk_state(ahb), axi, clk_state(axi), memnoc, clk_state(memnoc), dvm, clk_state(dvm));
+	if (ahb & CLK_OFF) {
+		gpu_log("GPUCC unclocked; not read");
+		return false;
+	}
+	sg.gpucc = ml_io_map(GPUCC_PA, GPUCC_SIZE);
+	if (sg.gpucc == 0) {
+		gpu_log("GPUCC map failed");
+		return false;
+	}
+	gpu_dump_gpucc("abl");
+	return true;
+}
+
+static bool
+gpu_branch_on(vm_offset_t base, uint32_t cbcr, const char *name)
+{
+	gpu_set(base, cbcr, CLK_ENABLE);
+	if (!gpu_wait(base, cbcr, CLK_OFF, 0, 200)) {
+		gpu_log("%s stays off: 0x%08x", name, gpu_rd(base, cbcr));
+		return false;
+	}
+	return true;
+}
+
+/* Stage 2: power the CX side the way Linux does before touching the GMU. */
+static bool
+gpu_stage_power(void)
+{
+	/* GCC: GPLL0 outputs into GPUCC, then the GPU's bus branches. */
+	gpu_set(sg.gcc, GCC_GPU_VOTE, GCC_GPU_GPLL0 | GCC_GPU_GPLL0_DIV);
+	delay(10);
+	if (!gpu_branch_on(sg.gcc, GCC_GPU_MEMNOC, "gcc memnoc_gfx") ||
+	    !gpu_branch_on(sg.gcc, GCC_GPU_SNOC_DVM, "gcc snoc_dvm_gfx") ||
+	    !gpu_branch_on(sg.gcc, GCC_DDRSS_GPU_AXI, "gcc ddrss_gpu_axi")) {
+		return false;
+	}
+
+	/* CX GDSC (gdsc.c gdsc_init + gdsc_enable for a VOTABLE GDSC with a
+	 * gds_hw_ctrl status register; clk_dis_wait_val 8). */
+	uint32_t g = gpu_rd(sg.gpucc, GPUCC_CX_GDSCR);
+	g &= ~(GDSC_HW_CONTROL | GDSC_SW_OVERRIDE | (0xfu << 20) | (0xfu << 16) | (0xfu << 12));
+	g |= (0x2u << 20) | (0x8u << 16) | (0x8u << 12);
+	gpu_wr(sg.gpucc, GPUCC_CX_GDSCR, g);
+	gpu_wr(sg.gpucc, GPUCC_CX_GDSCR, g & ~GDSC_SW_COLLAPSE);
+	delay(1);
+	if (!gpu_wait(sg.gpucc, GPUCC_CX_GDS_HW, GDSC_PWR_ON, GDSC_PWR_ON, 1500)) {
+		gpu_log("cx_gdsc does not power up: gdscr 0x%08x gds_hw 0x%08x",
+		    gpu_rd(sg.gpucc, GPUCC_CX_GDSCR), gpu_rd(sg.gpucc, GPUCC_CX_GDS_HW));
+		return false;
+	}
+	delay(1);
+
+	/* GPUCC clocks. gmu_clk_src: 200 MHz = GPLL0 div (source 6) / 1.5,
+	 * hid divider field 2*1.5-1 = 2 (rcg2 shared ops: force the root on,
+	 * write CFG, latch it with UPDATE). */
+	if (!gpu_branch_on(sg.gpucc, GPUCC_CXO, "gpucc cxo")) {
+		return false;
+	}
+	gpu_set(sg.gpucc, GPUCC_GMU_RCG, RCG_ROOT_EN);
+	if (!gpu_wait(sg.gpucc, GPUCC_GMU_RCG, RCG_ROOT_OFF, 0, 500)) {
+		gpu_log("gmu_clk_src root stays off: cmd 0x%08x", gpu_rd(sg.gpucc, GPUCC_GMU_RCG));
+		return false;
+	}
+	uint32_t cfg = gpu_rd(sg.gpucc, GPUCC_GMU_RCG + 4);
+	cfg = (cfg & ~(0x7u << 8 | 0x1fu | 0x3u << 12)) | (6u << 8) | 2u;
+	gpu_wr(sg.gpucc, GPUCC_GMU_RCG + 4, cfg);
+	gpu_set(sg.gpucc, GPUCC_GMU_RCG, RCG_UPDATE);
+	if (!gpu_wait(sg.gpucc, GPUCC_GMU_RCG, RCG_UPDATE, 0, 500)) {
+		gpu_log("gmu_clk_src update stuck: cmd 0x%08x cfg 0x%08x",
+		    gpu_rd(sg.gpucc, GPUCC_GMU_RCG), gpu_rd(sg.gpucc, GPUCC_GMU_RCG + 4));
+		return false;
+	}
+	/* Recommended WAKEUP/SLEEP for cx_gmu (gpucc-sc7180.c probe). */
+	uint32_t gmu = gpu_rd(sg.gpucc, GPUCC_CX_GMU);
+	gpu_wr(sg.gpucc, GPUCC_CX_GMU, (gmu & ~(0xffu << 4)) | (0xfu << 8) | (0xfu << 4));
+	bool ok = gpu_branch_on(sg.gpucc, GPUCC_CX_GMU, "gpucc cx_gmu") &&
+	    gpu_branch_on(sg.gpucc, GPUCC_CX_SNOC_DVM, "gpucc cx_snoc_dvm");
+	gpu_wr(sg.gpucc, GPUCC_GMU_RCG, gpu_rd(sg.gpucc, GPUCC_GMU_RCG) & ~RCG_ROOT_EN);
+	gpu_dump_gpucc("cx up");
+	return ok;
+}
