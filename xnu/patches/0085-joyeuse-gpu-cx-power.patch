+static void
+gpu_log(const char *fmt, ...)
+{
+	char line[256];
+	va_list ap;
+	va_start(ap, fmt);
+	int n = vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	if (n < 0) {
+		return;
+	}
+	printf("SWEET GPU: %s\n", line);
+	size_t len = strnlen(line, sizeof(line));
+	if (sweet_gpu_log_len + len + 2 <= sizeof(sweet_gpu_log)) {
+		memcpy(sweet_gpu_log + sweet_gpu_log_len, line, len);
+		sweet_gpu_log_len += len;
+		sweet_gpu_log[sweet_gpu_log_len++] = '\n';
+		sweet_gpu_log[sweet_gpu_log_len] = '\0';
+	}
