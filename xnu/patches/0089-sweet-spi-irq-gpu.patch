+/*
+ * SWEET: peripheral interrupts (GIC SPIs) for the built-in drivers.
+ *
+ * XNU here has no IOKit interrupt controller for the GIC: the timer and the
+ * IPIs are handled in sleh_irq directly (osfmk/arm64/sleh.c), and every other
+ * INTID went to cpu_data's interrupt_handler, which nothing registers. A
+ * driver now calls sweet_irq_register(), which programs the SPI in the
+ * distributor (Group 1 non-secure, priority 0xa0 like the timer, level or
+ * edge, routed to the boot CPU) and enables it; sleh_irq hands every
+ * INTID >= 32 to sweet_spi_dispatch() before the old path and sends the EOI
+ * afterwards. Handlers run in primary interrupt context with interrupts
+ * masked: they must clear the device's interrupt source and may only do
+ * what is safe there (register access, thread_wakeup).
+ *
+ * GICD at 0x17a00000 on both SM7150 (sweet) and SM7125 (joyeuse).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+#include <kern/locks.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+typedef void (*sweet_irq_handler_t)(void *ctx, uint32_t intid);
+int sweet_irq_register(uint32_t intid, bool edge, sweet_irq_handler_t handler, void *ctx);
+void sweet_irq_enable(uint32_t intid, bool enable);
+bool sweet_spi_dispatch(uint32_t intid);
+
+#define GICD_PA           0x17a00000u
+#define GICD_SIZE         0x10000u
+#define GICD_TYPER        0x0004u
+#define GICD_IGROUPR      0x0080u
+#define GICD_ISENABLER    0x0100u
+#define GICD_ICENABLER    0x0180u
+#define GICD_ICPENDR      0x0280u
+#define GICD_IPRIORITYR   0x0400u
+#define GICD_ICFGR        0x0c00u
+#define GICD_IGRPMODR     0x0d00u
+#define GICD_IROUTER      0x6000u
+#define SWEET_IRQ_SLOTS   16
+
+static struct {
+	uint32_t intid;
+	sweet_irq_handler_t handler;
+	void *ctx;
+	uint64_t count;
+} sweet_irq_slots[SWEET_IRQ_SLOTS];
+static vm_offset_t sweet_gicd;
+static uint32_t sweet_gic_lines;
+
+static uint32_t
+gicd_rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(sweet_gicd + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+gicd_wr(uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sweet_gicd + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+void
+sweet_irq_enable(uint32_t intid, bool enable)
+{
+	if (sweet_gicd && intid >= 32 && intid < sweet_gic_lines) {
+		gicd_wr((enable ? GICD_ISENABLER : GICD_ICENABLER) + 4 * (intid / 32), 1u << (intid % 32));
+	}
+}
+
+int
+sweet_irq_register(uint32_t intid, bool edge, sweet_irq_handler_t handler, void *ctx)
+{
+	if (!sweet_gicd) {
+		sweet_gicd = ml_io_map(GICD_PA, GICD_SIZE);
+		if (!sweet_gicd) {
+			return ENOMEM;
+		}
+		sweet_gic_lines = 32 * ((gicd_rd(GICD_TYPER) & 0x1f) + 1);
+	}
+	if (intid < 32 || intid >= sweet_gic_lines || intid > 1019 || !handler) {
+		return EINVAL;
+	}
+	unsigned free_slot = SWEET_IRQ_SLOTS;
+	for (unsigned i = 0; i < SWEET_IRQ_SLOTS; ++i) {
+		if (sweet_irq_slots[i].handler && sweet_irq_slots[i].intid == intid) {
+			return EBUSY;
+		}
+		if (!sweet_irq_slots[i].handler && free_slot == SWEET_IRQ_SLOTS) {
+			free_slot = i;
+		}
+	}
+	if (free_slot == SWEET_IRQ_SLOTS) {
+		return ENOSPC;
+	}
+	uint32_t bit = 1u << (intid % 32);
+	sweet_irq_enable(intid, false);
+	/* Group 1 non-secure (a secure SPI reads back 0 and stays TZ's). */
+	gicd_wr(GICD_IGROUPR + 4 * (intid / 32), gicd_rd(GICD_IGROUPR + 4 * (intid / 32)) | bit);
+	if (!(gicd_rd(GICD_IGROUPR + 4 * (intid / 32)) & bit)) {
+		printf("SWEET IRQ: INTID %u is not a non-secure interrupt\n", intid);
+		return EPERM;
+	}
+	uint32_t prio = gicd_rd(GICD_IPRIORITYR + (intid & ~3u));
+	prio = (prio & ~(0xffu << (8 * (intid % 4)))) | (0xa0u << (8 * (intid % 4)));
+	gicd_wr(GICD_IPRIORITYR + (intid & ~3u), prio);
+	uint32_t cfg = gicd_rd(GICD_ICFGR + 4 * (intid / 16));
+	uint32_t edge_bit = 2u << (2 * (intid % 16));
+	gicd_wr(GICD_ICFGR + 4 * (intid / 16), edge ? (cfg | edge_bit) : (cfg & ~edge_bit));
+	/* Route to the boot CPU (affinity of logical CPU 0). */
+	const ml_topology_info_t *topo = ml_get_topology_info();
+	uint64_t aff = topo->cpus[0].phys_id & 0xff00ffffffull;
+	*(volatile uint64_t *)(sweet_gicd + GICD_IROUTER + 8 * intid) = aff;
+	__asm__ volatile ("dsb osh" ::: "memory");
+	gicd_wr(GICD_ICPENDR + 4 * (intid / 32), bit);
+	sweet_irq_slots[free_slot].ctx = ctx;
+	sweet_irq_slots[free_slot].intid = intid;
+	sweet_irq_slots[free_slot].count = 0;
+	__atomic_store_n(&sweet_irq_slots[free_slot].handler, handler, __ATOMIC_RELEASE);
+	sweet_irq_enable(intid, true);
+	printf("SWEET IRQ: INTID %u (%s) -> CPU 0x%llx, %u lines\n", intid, edge ? "edge" : "level",
+	    aff, sweet_gic_lines);
+	return 0;
+}
+
+bool
+sweet_spi_dispatch(uint32_t intid)
+{
+	for (unsigned i = 0; i < SWEET_IRQ_SLOTS; ++i) {
+		sweet_irq_handler_t h = __atomic_load_n(&sweet_irq_slots[i].handler, __ATOMIC_ACQUIRE);
+		if (h && sweet_irq_slots[i].intid == intid) {
+			sweet_irq_slots[i].count++;
+			h(sweet_irq_slots[i].ctx, intid);
+			return true;
+		}
+	}
+	return false;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
