+}
+
+/* Stage 7: the GPU's interrupt (kgsl-3d0: GIC SPI 300, level, INTID 332). */
+typedef void (*sweet_irq_handler_t)(void *ctx, uint32_t intid);
+extern int sweet_irq_register(uint32_t intid, bool edge, sweet_irq_handler_t handler, void *ctx);
+
+#define GPU_INTID         332u
+#define CP_EVENT_WRITE    0x46u
+#define CACHE_FLUSH_TS    4u
+#define RBBM_INT_MASK     ((1u << 1) | (1u << 9) | (1u << 20) | (1u << 23) | (1u << 24) | (1u << 25))
+
+static struct {
+	volatile uint64_t count;
+	volatile uint32_t status;
+} gpu_irq;
+static int gpu_irq_chan;
+
+/* Primary interrupt context: ack the RBBM sources, then wake the waiter. */
+static void
+gpu_irq_handler(__unused void *ctx, __unused uint32_t intid)
+{
+	uint32_t status = core_rd(0x0201);            /* RBBM_INT_0_STATUS */
+	core_wr(0x0037, status);                      /* RBBM_INT_CLEAR_CMD */
+	gpu_irq.status |= status;
+	gpu_irq.count++;
+	thread_wakeup(&gpu_irq_chan);
+}
+
+static bool
+gpu_stage_irq(vm_offset_t smmu)
+{
+	int err = sweet_irq_register(GPU_INTID, false, gpu_irq_handler, NULL);
+	if (err) {
+		gpu_log("irq: register INTID %u failed: %d", GPU_INTID, err);
+		return false;
+	}
+	core_wr(0x0037, 0xffffffffu);                 /* clear anything stale */
+	core_wr(0x0038, RBBM_INT_MASK);               /* RBBM_INT_0_MASK */
+	volatile uint32_t *fence = (volatile uint32_t *)(gfx_mem + GMU_TABLES + GFX_SCRATCH_OFF + 0x40);
+	*fence = 0;
+	gfx_sync(GFX_SCRATCH_OFF, 0x1000);
+
+	/* a6xx_submit's fence: CACHE_FLUSH_TS with the IRQ bit writes the
+	 * seqno to memory and raises CP_CACHE_FLUSH_TS. */
+	uint64_t before = gpu_irq.count;
+	uint64_t deadline;
+	clock_interval_to_deadline(200, NSEC_PER_MSEC, &deadline);
+	assert_wait_deadline(&gpu_irq_chan, THREAD_UNINT, deadline);
+	rb_pkt7(CP_EVENT_WRITE, 4);
+	rb_out(CACHE_FLUSH_TS | (1u << 31));
+	rb_out(GFX_IOVA + GFX_SCRATCH_OFF + 0x40);
+	rb_out(0);
+	rb_out(0x618);
+	gfx_sync(GFX_RB_OFF, 0x8000);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	core_wr(0x0807, rb_wptr);                     /* CP_RB_WPTR */
+	wait_result_t wr = thread_block(THREAD_CONTINUE_NULL);
+	gfx_sync(GFX_SCRATCH_OFF, 0x1000);
+	gpu_log("irq: %s after %llu interrupt(s), status 0x%08x, fence %u (want 1560), rptr %u wptr %u",
+	    gpu_irq.count > before ? "RECEIVED" : (wr == THREAD_TIMED_OUT ? "timed out" : "woken, none"),
+	    gpu_irq.count - before, gpu_irq.status, *fence, core_rd(0x0806), rb_wptr);
+	gpu_smmu_faults(smmu, SMMU_GFX_IDX);
+	return gpu_irq.count > before && *fence == 0x618;
 }
 
