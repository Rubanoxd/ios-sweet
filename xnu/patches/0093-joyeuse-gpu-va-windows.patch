+/*
+ * One GPU address space is shared by every connection (no per-process
+ * pagetables yet), and Turnip places its buffers from the va_start it is
+ * given, so two processes on the same range collide. Each connection gets
+ * its own 512 MiB window of the client range instead; six fit.
+ */
+#define VA_WINDOW         0x20000000ull
+#define VA_SLOTS          6
+static uint8_t sVaSlots[VA_SLOTS];
+
+static int
+vaSlotTake(void)
+{
+	IOLockLock(sPoolLock);
+	int slot = -1;
+	for (int i = 0; i < VA_SLOTS && slot < 0; ++i) {
+		if (!sVaSlots[i]) {
+			sVaSlots[i] = 1;
+			slot = i;
+		}
+	}
+	IOLockUnlock(sPoolLock);
+	return slot;
+}
+
+static void
+vaSlotGive(int slot)
+{
+	IOLockLock(sPoolLock);
+	sVaSlots[slot] = 0;
+	IOLockUnlock(sPoolLock);
+}
