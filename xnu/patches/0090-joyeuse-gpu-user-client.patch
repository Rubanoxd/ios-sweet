+/*
+ * JOYEUSE: the Adreno 618 as an IOKit service for userspace.
+ *
+ * NativeAdrenoGpuPublished speaks UniXNU's NativeAdreno ABI v1
+ * (NativeAdrenoABI.h, MIT) in its direct form: IOServiceOpen type 0, then
+ * IOConnectCallStructMethod with the ABI method number as the selector and
+ * the fixed-size records as structure input/output. That is what their
+ * Turnip backend (tu_knl_darwin.cc, TU_DARWIN_SERVICE=NativeAdrenoGpuPublished)
+ * calls, so it can run on this kernel unchanged.
+ *
+ * The GPU itself is brought up by bsd/dev/sweet_gpu.c (sweetgpu=7); this
+ * file only keeps per-client buffer objects and calls its runtime:
+ *  - BoAlloc: physically contiguous memory from a pool of DDR the kernel
+ *    does not manage (see poolAlloc), zeroed through a write-combined
+ *    mapping. Handles are small integers: Turnip indexes a sparse array
+ *    with them.
+ *  - BoMap: the client picks the GPU address inside [va_start, va_start +
+ *    va_size); each physical segment goes into the SMMU bank 0 tables.
+ *  - BoCpuMap: the token is a clientMemoryForType type; the user maps it
+ *    write-combined (kIOMapWriteCombineCache in IOConnectMapMemory64).
+ *  - Submit: up to 16 indirect buffers, one CACHE_FLUSH_TS fence per job,
+ *    at most 8 jobs in flight (kIOReturnBusy), fences are 32 bits.
+ *  - BoImport: wires the caller's own pages (an IOSurface) as a buffer.
+ * One address space is shared by every client: there is no per-process
+ * isolation yet.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <libkern/c++/OSString.h>
+#include <sys/errno.h>
+#include <pexpert/pexpert.h>
+#include <stdarg.h>
+#include "NativeAdrenoABI.h"
+
+extern "C" {
+int vsnprintf(char *, size_t, const char *, va_list);
+struct sweet_gpu_info {
+	uint32_t chip_id, gmem_bytes;
+	uint64_t gmem_base, uche_trap_base, va_start, va_size;
+	uint32_t highest_bank_bit, ubwc_swizzle, macrotile_mode, ubwc_version;
+};
+int sweet_gpu_ready(void);
+void sweet_gpu_get_info(struct sweet_gpu_info *info);
+int sweet_gpu_vm_map(uint64_t iova, uint64_t pa, uint64_t bytes, bool writable);
+int sweet_gpu_vm_unmap(uint64_t iova, uint64_t bytes);
+int sweet_gpu_submit(const uint64_t *iova, const uint32_t *dwords, unsigned count, uint32_t *fence);
+int sweet_gpu_wait_fence(uint32_t fence, uint64_t timeout_ns);
+uint32_t sweet_gpu_retired(void);
+uint64_t sweet_gpu_timestamp(void);
+uint64_t sweet_gpu_faults(void);
+boolean_t pmap_valid_page(ppnum_t pn);
+}
+
+/* sweetgpudebug=1: every step goes to the console (and so to the USB live
+ * log) followed by a 300 ms pause, so the last line before a hard hang of
+ * the phone still gets out. */
+static int sAdrenoDebug = -1;
+
+static void
+adrenoStep(const char *fmt, ...) __printflike(1, 2);
+
+static void
+adrenoStep(const char *fmt, ...)
+{
+	if (sAdrenoDebug < 0) {
+		sAdrenoDebug = 0;
+		PE_parse_boot_argn("sweetgpudebug", &sAdrenoDebug, sizeof(sAdrenoDebug));
+	}
+	if (!sAdrenoDebug) {
+		return;
+	}
+	char line[160];
+	va_list ap;
+	va_start(ap, fmt);
+	vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	printf("SWEET ADRENO: %s\n", line);
+	IOSleep(300);
+}
+
+/*
+ * Buffer memory. Mapping a page of the kernel's own RAM write-combined into
+ * a process makes the pmap rewrite that page's physical-aperture PTE, and on
+ * this port that froze the phone (third sweet-gputest run: the last step
+ * was IOConnectMapMemory64). So buffers come from DDR the kernel does not
+ * manage: with the --highmem ADT XNU owns only the upper bank, and
+ * 0xb0000000-0xfd000000 of the lower one is above every fixed carve-out
+ * (it was the kernel's RAM in the low-memory layout). No physical-aperture
+ * mapping exists there, so the kernel and the client map it write-combined
+ * directly and the GPU reads it non-cacheable: no cache maintenance at all.
+ * First fit over 16 KiB pages; every buffer is physically contiguous.
+ */
+#define POOL_BASE         0xb0000000ull
+#define POOL_END          0xfd000000ull
+#define POOL_PAGE         0x4000ull
+#define POOL_PAGES        ((POOL_END - POOL_BASE) / POOL_PAGE)
+
+static IOLock *sPoolLock;
+static uint8_t sPoolMap[POOL_PAGES / 8];
+static int sPoolState;                  /* 0 unchecked, 1 usable, -1 refused */
+
+static bool
+poolUsable(void)
+{
+	if (sPoolState == 0) {
+		bool managed = pmap_valid_page((ppnum_t)(POOL_BASE >> PAGE_SHIFT)) ||
+		    pmap_valid_page((ppnum_t)((POOL_END - 1) >> PAGE_SHIFT));
+		sPoolState = managed ? -1 : 1;
+		printf("SWEET ADRENO: buffer pool 0x%llx-0x%llx %s\n", POOL_BASE, POOL_END,
+		    managed ? "is kernel RAM (no --highmem ADT?): refused" : "ready");
+	}
+	return sPoolState > 0;
+}
+
+static bool
+poolBit(uint64_t i)
+{
+	return (sPoolMap[i / 8] >> (i % 8)) & 1;
+}
+
+static void
+poolSet(uint64_t first, uint64_t count, bool used)
+{
+	for (uint64_t i = first; i < first + count; ++i) {
+		if (used) {
+			sPoolMap[i / 8] |= (uint8_t)(1u << (i % 8));
+		} else {
+			sPoolMap[i / 8] &= (uint8_t)~(1u << (i % 8));
+		}
+	}
+}
+
+static uint64_t
+poolAlloc(uint64_t bytes, uint64_t align)
+{
+	uint64_t count = (bytes + POOL_PAGE - 1) / POOL_PAGE;
+	uint64_t step = align > POOL_PAGE ? align / POOL_PAGE : 1;
+	uint64_t pa = 0;
+	IOLockLock(sPoolLock);
+	for (uint64_t first = 0; first + count <= POOL_PAGES && !pa; first += step) {
+		uint64_t i = 0;
+		while (i < count && !poolBit(first + i)) {
+			i++;
+		}
+		if (i == count) {
+			poolSet(first, count, true);
+			pa = POOL_BASE + first * POOL_PAGE;
+		}
+	}
+	IOLockUnlock(sPoolLock);
+	return pa;
+}
+
+static void
+poolFree(uint64_t pa, uint64_t bytes)
+{
+	IOLockLock(sPoolLock);
+	poolSet((pa - POOL_BASE) / POOL_PAGE, (bytes + POOL_PAGE - 1) / POOL_PAGE, false);
+	IOLockUnlock(sPoolLock);
+}
+
+class NativeAdrenoGpuPublished : public IOService {
+	OSDeclareDefaultStructors(NativeAdrenoGpuPublished);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(NativeAdrenoGpuPublished, IOService);
+
+bool
+NativeAdrenoGpuPublished::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	sPoolLock = IOLockAlloc();
+	if (sPoolLock == NULL) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "SweetAdrenoUserClient");
+	setProperty("NativeAdrenoAbiVersion", (unsigned long long)NativeAdrenoAbiVersion, 32);
+	registerService();
+	return true;
+}
+
+enum { kSweetAdrenoMaxObjects = 1024 };
+
+class SweetAdrenoUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(SweetAdrenoUserClient);
+
+	struct Entry {
+		IOMemoryDescriptor *md;      /* pool buffer (physical), or the wired import */
+		uint64_t bytes;
+		uint64_t pool_pa, pool_bytes;    /* pool buffer, 0 for an import */
+		uint64_t iova;               /* 0 while unmapped */
+		uint32_t last_fence;
+		uint32_t token;              /* CPU-map lease, 0 if none */
+		uint32_t metadata_bytes;
+		bool imported;
+		bool busy_known;             /* last_fence is valid */
+		char metadata[NativeAdrenoAbiMetadataBytes];
+	};
+	task_t fTask;
+	IOLock *fLock;
+	Entry *fEntries;
+	bool fQueues[NativeAdrenoAbiMaxQueues];
+
+	Entry *lookup(uint64_t handle);
+	IOReturn mapSegments(Entry *e, uint64_t iova, bool writable);
+	IOReturn freeEntry(Entry *e, bool wait);
+	static IOReturn fromErrno(int err);
+
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options,
+	    IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+	IOReturn dispatchMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference);
+};
+
+OSDefineMetaClassAndStructors(SweetAdrenoUserClient, IOUserClient);
+
+bool
+SweetAdrenoUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (type != 0 || !IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	fLock = IOLockAlloc();
+	fEntries = IONewZero(Entry, kSweetAdrenoMaxObjects);
+	return fLock != NULL && fEntries != NULL;
+}
+
+bool
+SweetAdrenoUserClient::start(IOService *provider)
+{
+	if (!OSDynamicCast(NativeAdrenoGpuPublished, provider) || !IOUserClient::start(provider)) {
+		return false;
+	}
+	fQueues[0] = true;          /* queue 0 exists from open() */
+	return true;
+}
+
+void
+SweetAdrenoUserClient::free(void)
+{
+	if (fEntries != NULL) {
+		for (unsigned i = 0; i < kSweetAdrenoMaxObjects; ++i) {
+			if (fEntries[i].md != NULL) {
+				(void)freeEntry(&fEntries[i], true);
+			}
+		}
+		IODelete(fEntries, Entry, kSweetAdrenoMaxObjects);
+		fEntries = NULL;
+	}
+	if (fLock != NULL) {
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+	IOUserClient::free();
+}
+
+IOReturn
+SweetAdrenoUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetAdrenoUserClient::fromErrno(int err)
+{
+	switch (err) {
+	case 0: return kIOReturnSuccess;
+	case EBUSY: return kIOReturnBusy;
+	case ETIMEDOUT: return kIOReturnTimeout;
+	case ENOMEM: return kIOReturnNoMemory;
+	case ENXIO: return kIOReturnNotReady;
+	case EEXIST: return kIOReturnExclusiveAccess;
+	case EINTR: return kIOReturnAborted;
+	default: return kIOReturnBadArgument;
+	}
+}
+
+SweetAdrenoUserClient::Entry *
+SweetAdrenoUserClient::lookup(uint64_t handle)
+{
+	if (handle == 0 || handle > kSweetAdrenoMaxObjects || fEntries[handle - 1].md == NULL) {
+		return NULL;
+	}
+	return &fEntries[handle - 1];
+}
+
+IOReturn
+SweetAdrenoUserClient::mapSegments(Entry *e, uint64_t iova, bool writable)
+{
+	for (uint64_t off = 0; off < e->bytes;) {
+		IOByteCount len = 0;
+		addr64_t pa = e->md->getPhysicalSegment(off, &len, kIOMemoryMapperNone);
+		adrenoStep("mapSegments: off 0x%llx pa 0x%llx len 0x%llx", off, (uint64_t)pa, (uint64_t)len);
+		if (pa == 0 || len == 0) {
+			(void)sweet_gpu_vm_unmap(iova, off);
+			return kIOReturnVMError;
+		}
+		if (len > e->bytes - off) {
+			len = (IOByteCount)(e->bytes - off);
+		}
+		int err = sweet_gpu_vm_map(iova + off, pa, len, writable);
+		if (err) {
+			if (off) {
+				(void)sweet_gpu_vm_unmap(iova, off);
+			}
+			return fromErrno(err);
+		}
+		off += len;
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetAdrenoUserClient::freeEntry(Entry *e, bool wait)
+{
+	if (e->busy_known && (int32_t)(sweet_gpu_retired() - e->last_fence) < 0) {
+		if (!wait || sweet_gpu_wait_fence(e->last_fence, 5000000000ull) != 0) {
+			return kIOReturnBusy;
+		}
+	}
+	if (e->iova) {
+		(void)sweet_gpu_vm_unmap(e->iova, e->bytes);
+	}
+	if (e->imported) {
+		e->md->complete();
+	}
+	e->md->release();
+	if (e->pool_pa) {
+		poolFree(e->pool_pa, e->pool_bytes);
+	}
+	bzero(e, sizeof(*e));
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetAdrenoUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options,
+    IOMemoryDescriptor **memory)
+{
+	adrenoStep("clientMemoryForType %u", (unsigned)type);
+	IOLockLock(fLock);
+	Entry *e = lookup(type);
+	if (e == NULL || e->token != type || e->imported) {
+		IOLockUnlock(fLock);
+		return kIOReturnBadArgument;
+	}
+	e->md->retain();
+	*memory = e->md;
+	*options = 0;               /* the cache mode is the caller's (write combine) */
+	IOLockUnlock(fLock);
+	return kIOReturnSuccess;
+}
+
+/* Exact sizes in and out, as the ABI requires; nothing is padded or guessed. */
+static bool
+sizesOk(IOExternalMethodArguments *args, uint32_t in, uint32_t out)
+{
+	if (args->structureInputDescriptor || args->structureOutputDescriptor ||
+	    args->structureInputSize != in || args->structureOutputSize < out) {
+		return false;
+	}
+	args->structureOutputSize = out;
+	return true;
+}
+
+/* The first calls of every boot go to the kernel log (bring-up aid). */
+static int sAdrenoTrace = 96;
+
+IOReturn
+SweetAdrenoUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference)
+{
+	bool trace = sAdrenoTrace > 0;
+	if (trace) {
+		sAdrenoTrace--;
+		printf("SWEET ADRENO: method %u in %u out %u\n", selector, args->structureInputSize,
+		    args->structureOutputSize);
+		adrenoStep("method %u start", selector);
+	}
+	IOReturn r = dispatchMethod(selector, args, dispatch, target, reference);
+	if (trace) {
+		printf("SWEET ADRENO: method %u -> 0x%x\n", selector, r);
+	}
+	return r;
+}
+
+IOReturn
+SweetAdrenoUserClient::dispatchMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	const void *in = args->structureInput;
+	void *out = args->structureOutput;
+	IOReturn ret = kIOReturnSuccess;
+
+	if (!sweet_gpu_ready()) {
+		return kIOReturnNotReady;
+	}
+	switch (selector) {
+	case NativeAdrenoMethodQuery: {
+		if (!sizesOk(args, 0, sizeof(NativeAdrenoAbiParams))) {
+			return kIOReturnBadArgument;
+		}
+		NativeAdrenoAbiParams p = {};
+		p.abi_version = NativeAdrenoAbiVersion;
+		p.input_bits = 32;
+		p.output_bits = 36;
+		p.flags = NativeAdrenoParamsHostImport;
+		p.max_bo_bytes = 1ull << NativeAdrenoAbiMaxBoBytesShift;
+		memcpy(out, &p, sizeof(p));
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodGetDeviceInfo: {
+		if (!sizesOk(args, 0, sizeof(NativeAdrenoAbiDeviceInfo))) {
+			return kIOReturnBadArgument;
+		}
+		struct sweet_gpu_info gi;
+		sweet_gpu_get_info(&gi);
+		NativeAdrenoAbiDeviceInfo d = {};
+		d.chip_id = gi.chip_id;
+		d.gmem_bytes = gi.gmem_bytes;
+		d.gmem_base = gi.gmem_base;
+		d.uche_trap_base = gi.uche_trap_base;
+		d.va_start = gi.va_start;
+		d.va_size = gi.va_size;
+		d.highest_bank_bit = gi.highest_bank_bit;
+		d.ubwc_swizzle = gi.ubwc_swizzle;
+		d.macrotile_mode = gi.macrotile_mode;
+		d.ubwc_version = gi.ubwc_version;
+		d.flags = NativeAdrenoDeviceClientIova;
+		memcpy(out, &d, sizeof(d));
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodGetTimestamp: {
+		if (!sizesOk(args, 0, sizeof(NativeAdrenoAbiTimestamp))) {
+			return kIOReturnBadArgument;
+		}
+		NativeAdrenoAbiTimestamp t = { sweet_gpu_timestamp() };
+		memcpy(out, &t, sizeof(t));
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodGetStatus: {
+		if (!sizesOk(args, 0, sizeof(NativeAdrenoAbiStatus))) {
+			return kIOReturnBadArgument;
+		}
+		NativeAdrenoAbiStatus st = { sweet_gpu_faults(), 0 };
+		memcpy(out, &st, sizeof(st));
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodWaitFence: {
+		if (!sizesOk(args, sizeof(NativeAdrenoAbiWaitFence), 0)) {
+			return kIOReturnBadArgument;
+		}
+		NativeAdrenoAbiWaitFence w;
+		memcpy(&w, in, sizeof(w));
+		if (w.fence == 0 || w.fence > UINT32_MAX) {
+			return kIOReturnBadArgument;
+		}
+		return fromErrno(sweet_gpu_wait_fence((uint32_t)w.fence, w.timeout_ns));
+	}
+	default:
+		break;
+	}
+
+	IOLockLock(fLock);
+	switch (selector) {
+	case NativeAdrenoMethodBoAlloc: {
+		if (!sizesOk(args, sizeof(NativeAdrenoAbiBoAlloc), sizeof(NativeAdrenoAbiBoAllocReply))) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		NativeAdrenoAbiBoAlloc a;
+		memcpy(&a, in, sizeof(a));
+		if (a.bytes == 0 || (a.bytes & 0xfff) || a.bytes > (1ull << NativeAdrenoAbiMaxBoBytesShift) ||
+		    a.align_log2 < 12 || a.align_log2 > 24 || a.contiguous > 1) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		Entry *e = NULL;
+		uint64_t handle = 0;
+		for (unsigned i = 0; i < kSweetAdrenoMaxObjects && !e; ++i) {
+			if (fEntries[i].md == NULL) {
+				e = &fEntries[i];
+				handle = i + 1;
+			}
+		}
+		if (e == NULL) {
+			ret = kIOReturnNoResources;
+			break;
+		}
+		if (!poolUsable()) {
+			ret = kIOReturnNoMemory;
+			break;
+		}
+		uint64_t size = (a.bytes + POOL_PAGE - 1) & ~(POOL_PAGE - 1);
+		uint64_t pa = poolAlloc(size, 1ull << a.align_log2);
+		if (pa == 0) {
+			ret = kIOReturnNoMemory;
+			break;
+		}
+		adrenoStep("BoAlloc: pool 0x%llx +0x%llx", pa, size);
+		IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress((IOPhysicalAddress)pa,
+		    (IOByteCount)size, kIODirectionInOut);
+		IOMemoryMap *zmap = md ? md->createMappingInTask(kernel_task, 0,
+		    kIOMapAnywhere | kIOMapWriteCombineCache) : NULL;
+		if (zmap == NULL) {
+			if (md) {
+				md->release();
+			}
+			poolFree(pa, size);
+			ret = kIOReturnNoMemory;
+			break;
+		}
+		bzero((void *)zmap->getVirtualAddress(), (size_t)size);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		zmap->release();
+		adrenoStep("BoAlloc: zeroed");
+		e->pool_pa = pa;
+		e->pool_bytes = size;
+		e->md = md;
+		e->bytes = a.bytes;
+		NativeAdrenoAbiBoAllocReply r = { handle };
+		memcpy(out, &r, sizeof(r));
+		break;
+	}
+	case NativeAdrenoMethodBoImport: {
+		if (!sizesOk(args, sizeof(NativeAdrenoAbiBoImport), sizeof(NativeAdrenoAbiBoAllocReply))) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		NativeAdrenoAbiBoImport im;
+		memcpy(&im, in, sizeof(im));
+		if (im.bytes == 0 || ((im.address | im.bytes) & 0xfff) ||
+		    im.bytes > (1ull << NativeAdrenoAbiMaxBoBytesShift)) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		Entry *e = NULL;
+		uint64_t handle = 0;
+		for (unsigned i = 0; i < kSweetAdrenoMaxObjects && !e; ++i) {
+			if (fEntries[i].md == NULL) {
+				e = &fEntries[i];
+				handle = i + 1;
+			}
+		}
+		if (e == NULL) {
+			ret = kIOReturnNoResources;
+			break;
+		}
+		IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange(im.address, im.bytes,
+		    kIODirectionInOut, fTask);
+		if (md == NULL || md->prepare() != kIOReturnSuccess) {
+			if (md) {
+				md->release();
+			}
+			ret = kIOReturnVMError;
+			break;
+		}
+		e->md = md;
+		e->bytes = im.bytes;
+		e->imported = true;
+		NativeAdrenoAbiBoAllocReply r = { handle };
+		memcpy(out, &r, sizeof(r));
+		break;
+	}
+	case NativeAdrenoMethodBoMap: {
+		if (!sizesOk(args, sizeof(NativeAdrenoAbiBoMap), sizeof(NativeAdrenoAbiBoMapReply))) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		NativeAdrenoAbiBoMap m;
+		memcpy(&m, in, sizeof(m));
+		Entry *e = lookup(m.handle);
+		if (e == NULL || e->iova || !(m.permissions & 1) || (m.permissions & ~3u) ||
+		    m.writeback > 1 || (m.shareability != 2 && m.shareability != 3) || m.reserved) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		adrenoStep("BoMap: handle %llu at 0x%llx", m.handle, m.iova);
+		ret = mapSegments(e, m.iova, (m.permissions & 2) != 0);
+		adrenoStep("BoMap: 0x%x", ret);
+		if (ret == kIOReturnSuccess) {
+			e->iova = m.iova;
+			NativeAdrenoAbiBoMapReply r = { m.iova };
+			memcpy(out, &r, sizeof(r));
+		}
+		break;
+	}
+	case NativeAdrenoMethodBoFree: {
+		if (!sizesOk(args, sizeof(NativeAdrenoAbiBoFree), 0)) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		NativeAdrenoAbiBoFree f;
+		memcpy(&f, in, sizeof(f));
+		Entry *e = lookup(f.handle);
+		ret = e ? freeEntry(e, false) : kIOReturnBadArgument;
+		break;
+	}
+	case NativeAdrenoMethodBoCpuMap: {
+		if (!sizesOk(args, sizeof(NativeAdrenoAbiBoCpuMap), sizeof(NativeAdrenoAbiBoCpuMapReply))) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		NativeAdrenoAbiBoCpuMap c;
+		memcpy(&c, in, sizeof(c));
+		Entry *e = lookup(c.handle);
+		if (e == NULL || e->imported) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		e->token = (uint32_t)c.handle;      /* clientMemoryForType type */
+		NativeAdrenoAbiBoCpuMapReply r = {};
+		r.token = e->token;
+		r.bytes = e->bytes;
+		memcpy(out, &r, sizeof(r));
+		break;
+	}
+	case NativeAdrenoMethodBoCpuUnmap: {
+		if (!sizesOk(args, sizeof(NativeAdrenoAbiBoCpuUnmap), 0)) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		NativeAdrenoAbiBoCpuUnmap c;
+		memcpy(&c, in, sizeof(c));
+		Entry *e = lookup(c.handle);
+		if (e == NULL || e->token == 0 || e->token != c.token || c.reserved) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		e->token = 0;
+		break;
+	}
+	case NativeAdrenoMethodSubmit: {
+		if (!sizesOk(args, sizeof(NativeAdrenoAbiSubmit), sizeof(NativeAdrenoAbiSubmitReply))) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		NativeAdrenoAbiSubmit *s = IONew(NativeAdrenoAbiSubmit, 1);
+		if (s == NULL) {
+			ret = kIOReturnNoMemory;
+			break;
+		}
+		memcpy(s, in, sizeof(*s));
+		uint64_t iova[NativeAdrenoAbiMaxBuffers];
+		uint32_t dwords[NativeAdrenoAbiMaxBuffers];
+		Entry *used[NativeAdrenoAbiMaxBuffers];
+		if (s->buffer_count == 0 || s->buffer_count > NativeAdrenoAbiMaxBuffers || s->reserved ||
+		    s->queue >= NativeAdrenoAbiMaxQueues || !fQueues[s->queue]) {
+			ret = kIOReturnBadArgument;
+		}
+		for (uint32_t i = 0; ret == kIOReturnSuccess && i < s->buffer_count; ++i) {
+			const NativeAdrenoAbiSubmitBuffer *b = &s->buffers[i];
+			Entry *e = lookup(b->handle);
+			if (e == NULL || !e->iova || b->bytes == 0 || (b->bytes & 3) || (b->iova & 3) ||
+			    b->iova < e->iova || b->iova + b->bytes > e->iova + e->bytes ||
+			    b->bytes / 4 > 0xfffff) {
+				ret = kIOReturnBadArgument;
+				break;
+			}
+			iova[i] = b->iova;
+			dwords[i] = (uint32_t)(b->bytes / 4);
+			used[i] = e;
+		}
+		if (ret == kIOReturnSuccess && s->wait_fence) {
+			IOLockUnlock(fLock);
+			ret = fromErrno(sweet_gpu_wait_fence((uint32_t)s->wait_fence, s->wait_timeout_ns));
+			IOLockLock(fLock);
+		}
+		uint32_t fence = 0;
+		if (ret == kIOReturnSuccess) {
+			ret = fromErrno(sweet_gpu_submit(iova, dwords, s->buffer_count, &fence));
+		}
+		if (ret == kIOReturnSuccess) {
+			for (uint32_t i = 0; i < s->buffer_count; ++i) {
+				if (lookup(s->buffers[i].handle) == used[i]) {
+					used[i]->last_fence = fence;
+					used[i]->busy_known = true;
+				}
+			}
+			NativeAdrenoAbiSubmitReply r = { fence };
+			memcpy(out, &r, sizeof(r));
+		}
+		IODelete(s, NativeAdrenoAbiSubmit, 1);
+		break;
+	}
+	case NativeAdrenoMethodSetMetadata: {
+		if (!sizesOk(args, sizeof(NativeAdrenoAbiMetadata), 0)) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		NativeAdrenoAbiMetadata md;
+		memcpy(&md, in, sizeof(md));
+		Entry *e = lookup(md.handle);
+		if (e == NULL || md.bytes > NativeAdrenoAbiMetadataBytes || md.reserved) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		memcpy(e->metadata, md.text, md.bytes);
+		e->metadata_bytes = md.bytes;
+		break;
+	}
+	case NativeAdrenoMethodGetMetadata: {
+		if (!sizesOk(args, sizeof(NativeAdrenoAbiMetadata), sizeof(NativeAdrenoAbiMetadata))) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		NativeAdrenoAbiMetadata md;
+		memcpy(&md, in, sizeof(md));
+		Entry *e = lookup(md.handle);
+		if (e == NULL || md.reserved) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		NativeAdrenoAbiMetadata r = {};
+		r.handle = md.handle;
+		r.bytes = e->metadata_bytes < md.bytes ? e->metadata_bytes : md.bytes;
+		memcpy(r.text, e->metadata, r.bytes);
+		memcpy(out, &r, sizeof(r));
+		break;
+	}
+	case NativeAdrenoMethodCreateQueue: {
+		if (!sizesOk(args, 0, sizeof(NativeAdrenoAbiQueueReply))) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		uint64_t id = 0;
+		for (unsigned i = 1; i < NativeAdrenoAbiMaxQueues && !id; ++i) {
+			if (!fQueues[i]) {
+				fQueues[i] = true;
+				id = i;
+			}
+		}
+		if (!id) {
+			ret = kIOReturnNoResources;
+			break;
+		}
+		NativeAdrenoAbiQueueReply r = { id };
+		memcpy(out, &r, sizeof(r));
+		break;
+	}
+	case NativeAdrenoMethodCloseQueue: {
+		if (!sizesOk(args, sizeof(NativeAdrenoAbiQueue), 0)) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		NativeAdrenoAbiQueue q;
+		memcpy(&q, in, sizeof(q));
+		if (q.queue == 0 || q.queue >= NativeAdrenoAbiMaxQueues || !fQueues[q.queue]) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		fQueues[q.queue] = false;
+		break;
+	}
+	default:
+		ret = kIOReturnUnsupported;
+		break;
+	}
+	IOLockUnlock(fLock);
+	return ret;
+}
+#endif /* SWEET */
