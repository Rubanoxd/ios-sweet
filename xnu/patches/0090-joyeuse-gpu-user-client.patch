+/*
+ * Runtime for the user client (iokit/Kernel/arm/SweetAdreno.cpp, UniXNU's
+ * NativeAdreno ABI v1): after stage 7 the GPU stays up (GPU_SET held) and
+ * this exports its address space, ring and fences.
+ *
+ * Address space: SMMU bank 0, 32-bit input. The kernel's ring, microcode and
+ * scratch stay at GFX_IOVA; clients place buffers in [GPU_CLIENT_VA_START,
+ * GPU_CLIENT_VA_END). L2/L3 tables come from 16 KiB kernel pages cut in four.
+ * Submissions: one CP_INDIRECT_BUFFER per client buffer, then a
+ * CACHE_FLUSH_TS event with its IRQ bit that writes the sequence number to
+ * the fence word; at most GPU_MAX_INFLIGHT jobs are outstanding.
+ */
+#define GPU_CLIENT_VA_START 0x40000000ull
+#define GPU_CLIENT_VA_END   0x100000000ull
+#define GPU_MAX_INFLIGHT    8u
+#define GPU_FENCE_OFF       (GFX_SCRATCH_OFF + 0x40)
+#define CP_INDIRECT_BUFFER  0x3fu
+
+struct sweet_gpu_info {
+	uint32_t chip_id, gmem_bytes;
+	uint64_t gmem_base, uche_trap_base, va_start, va_size;
+	uint32_t highest_bank_bit, ubwc_swizzle, macrotile_mode, ubwc_version;
+};
+int sweet_gpu_ready(void);
+void sweet_gpu_get_info(struct sweet_gpu_info *info);
+int sweet_gpu_vm_map(uint64_t iova, uint64_t pa, uint64_t bytes, bool writable);
+int sweet_gpu_vm_unmap(uint64_t iova, uint64_t bytes);
+int sweet_gpu_submit(const uint64_t *iova, const uint32_t *dwords, unsigned count, uint32_t *fence);
+int sweet_gpu_wait_fence(uint32_t fence, uint64_t timeout_ns);
+uint32_t sweet_gpu_retired(void);
+uint64_t sweet_gpu_timestamp(void);
+uint64_t sweet_gpu_faults(void);
+
+static bool gpu_ready;
+static int sweet_gpu_watch_chan;
+static int gpu_trace = 64;
+static int gpu_debug;                   /* sweetgpudebug=1: slow step trace */              /* kernel log lines left for maps and submits */
+static vm_offset_t gfx_smmu;
+static lck_grp_t *gpu_lck_grp;
+static lck_mtx_t *gpu_mtx;
+static uint32_t gpu_seqno;
+static vm_offset_t gfx_l2_va[4];
+static uint64_t gfx_l2_pa[4];
+static vm_offset_t *gfx_l3_va[4];          /* [512] each, allocated with the L2 */
+static uint64_t *gfx_l3_pa[4];
+static vm_offset_t gfx_pool;
+static uint64_t gfx_pool_pa;
+static unsigned gfx_pool_left;
+
+/* One zeroed 4 KiB table: a quarter of a contiguous 16 KiB kernel page. */
+static bool
+gfx_table_alloc(vm_offset_t *va, uint64_t *pa)
+{
+	if (!gfx_pool_left) {
+		if (kmem_alloc_contig(kernel_map, &gfx_pool, 0x4000, PAGE_MASK, 0, 0,
+		    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return false;
+		}
+		gfx_pool_pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)gfx_pool));
+		flush_dcache64((addr64_t)gfx_pool_pa, 0x4000, TRUE);
+		gfx_pool_left = 4;
+	}
+	gfx_pool_left--;
+	*va = gfx_pool + 0x1000 * gfx_pool_left;
+	*pa = gfx_pool_pa + 0x1000 * gfx_pool_left;
+	return true;
+}
+
+static void
+gfx_tlb_flush(void)
+{
+	uint32_t cb = 0x8000 + 0x1000 * SMMU_GFX_IDX;    /* 8 global pages of 4 KiB */
+	gpu_wr(gfx_smmu, cb + 0x618, 0);                /* TLBIALL */
+	gpu_wr(gfx_smmu, cb + 0x7f0, 0);                /* TLBSYNC */
+	(void)gpu_wait(gfx_smmu, cb + 0x7f4, 1u, 0, 1000);
+}
+
+/* Level-3 entry pointer for iova, creating the L2/L3 tables on demand. */
+static uint64_t *
+gfx_pte(uint64_t iova, bool create, uint64_t *pte_pa)
+{
+	unsigned i1 = (unsigned)(iova >> 30) & 3, i2 = (unsigned)(iova >> 21) & 0x1ff;
+	unsigned i3 = (unsigned)(iova >> 12) & 0x1ff;
+	if (!gfx_l2_va[i1]) {
+		if (!create) {
+			return NULL;
+		}
+		vm_offset_t *l3v = kalloc_data(512 * sizeof(vm_offset_t), Z_WAITOK | Z_ZERO);
+		uint64_t *l3p = kalloc_data(512 * sizeof(uint64_t), Z_WAITOK | Z_ZERO);
+		if (!l3v || !l3p || !gfx_table_alloc(&gfx_l2_va[i1], &gfx_l2_pa[i1])) {
+			return NULL;
+		}
+		gfx_l3_va[i1] = l3v;
+		gfx_l3_pa[i1] = l3p;
+		((uint64_t *)gfx_mem)[i1] = gfx_l2_pa[i1] | 0x3;
+		flush_dcache64((addr64_t)(gfx_mem_pa + 8 * i1), 8, TRUE);
+	}
+	if (!gfx_l3_va[i1][i2]) {
+		if (!create || !gfx_table_alloc(&gfx_l3_va[i1][i2], &gfx_l3_pa[i1][i2])) {
+			return NULL;
+		}
+		((uint64_t *)gfx_l2_va[i1])[i2] = gfx_l3_pa[i1][i2] | 0x3;
+		flush_dcache64((addr64_t)(gfx_l2_pa[i1] + 8 * i2), 8, TRUE);
+	}
+	*pte_pa = gfx_l3_pa[i1][i2] + 8 * i3;
+	return (uint64_t *)gfx_l3_va[i1][i2] + i3;
+}
+
+/* Every core register access stalls the bus for good if GX has collapsed
+ * (the first user client test froze the phone on its first core read,
+ * minutes after bring-up), so the runtime looks at the GX GDSC (GPUCC is
+ * in CX and always readable) first and asks the GMU again if it is off. */
+static bool
+gpu_gx_on(void)
+{
+	return (gpu_rd(sg.gpucc, GPUCC_GX_GDSCR) & GDSC_PWR_ON) != 0;
+}
+
+static bool
+gpu_ensure_gx(const char *where)
+{
+	if (gpu_gx_on()) {
+		return true;
+	}
+	gpu_log("%s: GX is off (gx_gdscr 0x%08x rpmh_state 0x%08x sptprac 0x%08x gmu2host 0x%08x); "
+	    "GPU_SET again", where, gpu_rd(sg.gpucc, GPUCC_GX_GDSCR), gpu_rd(sg.gmu, GMU_REG(0x50ec)),
+	    gpu_rd(sg.gmu, GMU_REG(0x50d0)), gpu_rd(sg.gmu, GMU_REG(0x5192)));
+	(void)gmu_oob("GPU_SET", 16, 24);
+	for (unsigned i = 0; i < 10000 && !gpu_gx_on(); ++i) {
+		delay(1);
+	}
+	gpu_log("%s: GX %s", where, gpu_gx_on() ? "back on" : "still off");
+	return gpu_gx_on();
+}
+
+int
+sweet_gpu_ready(void)
+{
+	return gpu_ready;
+}
+
+void
+sweet_gpu_get_info(struct sweet_gpu_info *info)
+{
+	info->chip_id = 0x06010800;            /* KGSL-style: decodes to 618 */
+	info->gmem_bytes = 0x80000;
+	info->gmem_base = 0x100000;            /* UCHE_GMEM_RANGE_MIN */
+	info->uche_trap_base = 0x0001fffffffff000ull;
+	info->va_start = GPU_CLIENT_VA_START;
+	info->va_size = GPU_CLIENT_VA_END - GPU_CLIENT_VA_START;
+	info->highest_bank_bit = 14;           /* a6xx_calc_ubwc_config, a618 */
+	info->ubwc_swizzle = 0x6;
+	info->macrotile_mode = 0;
+	info->ubwc_version = 2;
+}
+
+int
+sweet_gpu_vm_map(uint64_t iova, uint64_t pa, uint64_t bytes, bool writable)
+{
+	if (!gpu_ready || (iova | pa | bytes) & 0xfff || !bytes || iova < GPU_CLIENT_VA_START ||
+	    iova + bytes > GPU_CLIENT_VA_END || iova + bytes < iova || (pa + bytes) >> 36) {
+		return EINVAL;
+	}
+	int err = 0;
+	if (gpu_trace > 0) {
+		gpu_trace--;
+		printf("SWEET GPU: map 0x%llx -> pa 0x%llx +0x%llx %s\n", iova, pa, bytes, writable ? "rw" : "ro");
+	}
+	lck_mtx_lock(gpu_mtx);
+	if (gpu_debug) {
+		printf("SWEET GPU: vm_map 0x%llx: locked, l1[%u] 0x%llx\n", iova, (unsigned)(iova >> 30) & 3,
+		    ((uint64_t *)gfx_mem)[(iova >> 30) & 3]);
+		delay(300000);
+	}
+	for (uint64_t off = 0; off < bytes && !err; off += 0x1000) {
+		uint64_t pte_pa;
+		uint64_t *pte = gfx_pte(iova + off, true, &pte_pa);
+		if (!pte) {
+			err = ENOMEM;
+		} else if (*pte & 1) {
+			err = EEXIST;
+		} else {
+			*pte = (pa + off) | 0x3 | (1ull << 6) | (writable ? 0 : (1ull << 7)) | (2ull << 8) |
+			    (1ull << 10) | (1ull << 11);
+			flush_dcache64((addr64_t)pte_pa, 8, TRUE);
+		}
+	}
+	if (gpu_debug) {
+		printf("SWEET GPU: vm_map 0x%llx: ptes written (err %d), TLB flush\n", iova, err);
+		delay(300000);
+	}
+	gfx_tlb_flush();
+	if (gpu_debug) {
+		printf("SWEET GPU: vm_map 0x%llx: TLB flushed\n", iova);
+		delay(300000);
+	}
+	lck_mtx_unlock(gpu_mtx);
+	if (err) {
+		(void)sweet_gpu_vm_unmap(iova, bytes);
+	}
+	return err;
 }
 
+int
+sweet_gpu_vm_unmap(uint64_t iova, uint64_t bytes)
+{
+	if (!gpu_ready || (iova | bytes) & 0xfff || iova < GPU_CLIENT_VA_START ||
+	    iova + bytes > GPU_CLIENT_VA_END || iova + bytes < iova) {
+		return EINVAL;
+	}
+	lck_mtx_lock(gpu_mtx);
+	for (uint64_t off = 0; off < bytes; off += 0x1000) {
+		uint64_t pte_pa;
+		uint64_t *pte = gfx_pte(iova + off, false, &pte_pa);
+		if (pte && *pte) {
+			*pte = 0;
+			flush_dcache64((addr64_t)pte_pa, 8, TRUE);
+		}
+	}
+	gfx_tlb_flush();
+	lck_mtx_unlock(gpu_mtx);
+	return 0;
+}
+
+uint32_t
+sweet_gpu_retired(void)
+{
+	addr64_t pa = gfx_mem_pa + GMU_TABLES + GPU_FENCE_OFF;
+	flush_dcache64(pa, 64, TRUE);
+	return *(volatile uint32_t *)(gfx_mem + GMU_TABLES + GPU_FENCE_OFF);
+}
+
+int
+sweet_gpu_submit(const uint64_t *iova, const uint32_t *dwords, unsigned count, uint32_t *fence)
+{
+	if (!gpu_ready || !count || count > 16) {
+		return EINVAL;
+	}
+	lck_mtx_lock(gpu_mtx);
+	if (!gpu_ensure_gx("submit")) {
+		lck_mtx_unlock(gpu_mtx);
+		return ENXIO;
+	}
+	uint32_t need = 4 * count + 5 + 8;
+	uint32_t room = (core_rd(0x0806) - rb_wptr - 1) & (GFX_RB_DWORDS - 1);   /* CP_RB_RPTR */
+	if (gpu_seqno - sweet_gpu_retired() >= GPU_MAX_INFLIGHT || room < need) {
+		lck_mtx_unlock(gpu_mtx);
+		return EBUSY;
+	}
+	for (unsigned i = 0; i < count; ++i) {
+		rb_pkt7(CP_INDIRECT_BUFFER, 3);
+		rb_out((uint32_t)iova[i]);
+		rb_out((uint32_t)(iova[i] >> 32));
+		rb_out(dwords[i]);
+	}
+	uint32_t seq = ++gpu_seqno;
+	rb_pkt7(CP_EVENT_WRITE, 4);
+	rb_out(CACHE_FLUSH_TS | (1u << 31));
+	rb_out(GFX_IOVA + GPU_FENCE_OFF);
+	rb_out(0);
+	rb_out(seq);
+	gfx_sync(GFX_RB_OFF, 0x8000);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	core_wr(0x0807, rb_wptr);                     /* CP_RB_WPTR */
+	lck_mtx_unlock(gpu_mtx);
+	*fence = seq;
+	if (gpu_trace > 0) {
+		gpu_trace--;
+		printf("SWEET GPU: submit %u: %u buffer(s), first 0x%llx +%u dwords\n", seq, count,
+		    iova[0], dwords[0]);
+	}
+	return 0;
+}
+
+int
+sweet_gpu_wait_fence(uint32_t fence, uint64_t timeout_ns)
+{
+	if (!gpu_ready) {
+		return ENXIO;
+	}
+	if ((int32_t)(fence - gpu_seqno) > 0) {
+		return EINVAL;                            /* never submitted */
+	}
+	uint64_t deadline = 0;
+	if (timeout_ns) {
+		nanoseconds_to_absolutetime(timeout_ns, &deadline);
+		deadline += mach_absolute_time();
+	}
+	for (;;) {
+		if ((int32_t)(sweet_gpu_retired() - fence) >= 0) {
+			return 0;
+		}
+		if (!timeout_ns || mach_absolute_time() >= deadline) {
+			gpu_report_errors("wait");
+			if (timeout_ns >= 100000000ull && gpu_gx_on()) {
+				gpu_log("wait: fence %u not reached in %llu ms (retired %u, rptr %u wptr %u, "
+				    "rbbm_status 0x%08x)", fence, timeout_ns / 1000000, sweet_gpu_retired(),
+				    core_rd(0x0806), rb_wptr, core_rd(0x0210));
+				gpu_smmu_faults(gfx_smmu, SMMU_GFX_IDX);
+			}
+			return ETIMEDOUT;
+		}
+		assert_wait_deadline(&gpu_irq_chan, THREAD_ABORTSAFE, deadline);
+		if ((int32_t)(sweet_gpu_retired() - fence) >= 0) {
+			clear_wait(current_thread(), THREAD_AWAKENED);
+			return 0;
+		}
+		if (thread_block(THREAD_CONTINUE_NULL) == THREAD_INTERRUPTED) {
+			return EINTR;
+		}
+	}
+}
+
+uint64_t
+sweet_gpu_timestamp(void)
+{
+	if (!gpu_ready) {
+		return 0;
+	}
+	lck_mtx_lock(gpu_mtx);
+	if (!gpu_ensure_gx("timestamp")) {
+		lck_mtx_unlock(gpu_mtx);
+		return 0;
+	}
+	uint32_t hi, lo;
+	do {
+		hi = core_rd(0x0981);
+		lo = core_rd(0x0980);                     /* CP_ALWAYS_ON_COUNTER */
+	} while (hi != core_rd(0x0981));
+	lck_mtx_unlock(gpu_mtx);
+	return ((uint64_t)hi << 32) | lo;
+}
+
+uint64_t
+sweet_gpu_faults(void)
+{
+	return gpu_fault_count;
+}
+
+/* Logs every change of the GX/GMU power state for the first ten minutes. */
+static void
+gpu_gx_watch(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t last = ~0u;
+	for (unsigned i = 0; i < 600; ++i) {
+		uint32_t gx = gpu_rd(sg.gpucc, GPUCC_GX_GDSCR), rpmh = gpu_rd(sg.gmu, GMU_REG(0x50ec));
+		uint32_t key = (gx & GDSC_PWR_ON) | (rpmh & 0xff);
+		if (key != last) {
+			gpu_log("watch t+%us: gx_gdscr 0x%08x rpmh_state 0x%08x sptprac 0x%08x gmu2host 0x%08x "
+			    "ao_int 0x%08x", i, gx, rpmh, gpu_rd(sg.gmu, GMU_REG(0x50d0)),
+			    gpu_rd(sg.gmu, GMU_REG(0x5192)), gpu_rd(sg.gmu, GMU_REG(0x9305)));
+			last = key;
+		}
+		uint64_t deadline;
+		clock_interval_to_deadline(1, NSEC_PER_SEC, &deadline);
+		(void)assert_wait_deadline(&sweet_gpu_watch_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+static void
+gpu_runtime_start(vm_offset_t smmu)
+{
