+static uint32_t
+rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+wr32(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static bool
+wl_is_joyeuse(void)
+{
+	DTEntry root;
+	char const *compat = NULL;
+	unsigned int size = 0;
+	if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+	    SecureDTGetProperty(root, "compatible", (void const **)&compat, &size) != kSuccess) {
+		return false;
+	}
+	for (unsigned int i = 0; i < size; i += (unsigned int)strnlen(compat + i, size - i) + 1) {
+		if (!strncmp(compat + i, "xiaomi,joyeuse", size - i)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* SMEM is device memory here: only aligned 32-bit loads. */
+static uint32_t
+sm32(uint32_t off)
+{
+	return off <= SMEM_SIZE - 4 ? rd32(sw.smem, off & ~3u) : 0xffffffffu;
+}
+
+static uint16_t
+sm16(uint32_t off)
+{
+	return (uint16_t)(sm32(off & ~3u) >> (8u * (off & 2u)));
+}
+
+static void
+sm_bytes(uint32_t off, char *out, size_t len)
+{
+	for (size_t i = 0; i < len; ++i) {
+		out[i] = (char)(sm32((uint32_t)(off + i) & ~3u) >> (8u * ((off + i) & 3u)));
+	}
+}
+
+/* qcom_smem.c: struct smem_header, then the partition table 4 KiB before the end. */
+static bool
+smem_scan(void)
+{
+	sw.smem_version = sm32(64 + 4 * 7) >> 16;           /* version[SBL] */
+	uint32_t initialized = sm32(192);
+	wl_log("smem: version %u initialized %u available 0x%x", sw.smem_version, initialized, sm32(196));
+	uint32_t pt = SMEM_SIZE - 0x1000u;
+	char magic[5] = { 0 };
+	sm_bytes(pt, magic, 4);
+	if (memcmp(magic, "$TOC", 4)) {
+		wl_log("smem: no partition table (magic %02x%02x%02x%02x)", (uint8_t)magic[0],
+		    (uint8_t)magic[1], (uint8_t)magic[2], (uint8_t)magic[3]);
+		return sw.smem_version == 11;
+	}
+	uint32_t n = sm32(pt + 8);
+	wl_log("smem: ptable version %u, %u entries", sm32(pt + 4), n);
+	for (uint32_t i = 0; i < n && i < 32; ++i) {
+		uint32_t e = pt + 32 + 48 * i;
+		uint32_t off = sm32(e), size = sm32(e + 4), flags = sm32(e + 8);
+		uint32_t hosts = sm32(e + 12);
+		unsigned h0 = hosts & 0xffffu, h1 = hosts >> 16;
+		if (!off || !size || off >= SMEM_SIZE || size > SMEM_SIZE - off) {
+			continue;
+		}
+		/* Partitions of other host pairs are XPU-protected from apps (a read
+		 * stalls); like qcom_smem.c, touch only apps' and the global one. */
+		bool ours = h0 == SMEM_HOST_APPS || h1 == SMEM_HOST_APPS ||
+		    (h0 == SMEM_GLOBAL_HOST && h1 == SMEM_GLOBAL_HOST);
+		if (!ours) {
+			wl_log("smem: partition %u hosts %u/%u at 0x%x size 0x%x (not apps')", i, h0, h1, off, size);
+			continue;
+		}
+		char pm[5] = { 0 };
+		sm_bytes(off, pm, 4);
+		wl_log("smem: partition %u hosts %u/%u at 0x%x size 0x%x flags 0x%x %s free 0x%x", i, h0, h1, off,
+		    size, flags, memcmp(pm, "$PRT", 4) ? "BAD" : "$PRT", sm32(off + 12));
+		if (memcmp(pm, "$PRT", 4)) {
+			continue;
+		}
+		if (h0 == SMEM_GLOBAL_HOST && h1 == SMEM_GLOBAL_HOST) {
+			sw.global_off = off;
+			sw.global_size = size;
+			sw.global_line = sm32(e + 16);
+		}
+		if ((h0 == SMEM_HOST_APPS && h1 == SMEM_HOST_MODEM) || (h0 == SMEM_HOST_MODEM && h1 == SMEM_HOST_APPS)) {
+			sw.modem_off = off;
+			sw.modem_size = size;
+			sw.modem_line = sm32(e + 16);
+		}
+	}
+	return true;
+}
+
+/* Items of one partition (smem_private_entry: canary 0xa5a5, item, size,
+ * padding_data, padding_hdr): uncached ones upwards from the header, cached
+ * ones downwards from the end. Returns the item's offset or 0. */
+static uint32_t
+smem_part_find(uint32_t part, uint32_t part_size, uint32_t line, unsigned item, uint32_t *size)
+{
+	uint32_t free_uncached = sm32(part + 12), free_cached = sm32(part + 16);
+	if (!part || free_uncached > part_size || free_cached > part_size) {
+		return 0;
+	}
+	uint32_t ehdr = line > 16 && line <= 0x1000 ? line : 16;      /* ALIGN(sizeof(entry), cacheline) */
+	for (uint32_t e = part + part_size - ehdr, guard = 0; e > part + free_cached && guard < 4096; ++guard) {
+		uint32_t w0 = sm32(e), sz = sm32(e + 4), pads = sm32(e + 8);
+		if ((w0 & 0xffffu) != 0xa5a5u || sz > part_size) {
+			break;
+		}
+		if ((w0 >> 16) == item) {
+			if (size) {
+				*size = sz - (pads & 0xffffu);
+			}
+			return e - sz;
+		}
+		e -= sz + ehdr;
+	}
+	uint32_t e = part + 32, end = part + free_uncached;
+	for (unsigned guard = 0; e + 16 <= end && guard < 4096; ++guard) {
+		uint32_t w0 = sm32(e), sz = sm32(e + 4), pads = sm32(e + 8);
+		if ((w0 & 0xffffu) != 0xa5a5u) {
+			wl_log("smem: bad canary at 0x%x", e);
+			return 0;
+		}
+		uint32_t hdr = pads >> 16;
+		if ((w0 >> 16) == item) {
+			if (size) {
+				*size = sz - (pads & 0xffffu);
+			}
+			return e + 16 + hdr;
+		}
+		e += 16 + hdr + sz;
+	}
+	return 0;
+}
+
+static uint32_t
+smem_find(unsigned item, uint32_t *size)
+{
+	uint32_t at = smem_part_find(sw.modem_off, sw.modem_size, sw.modem_line, item, size);
+	if (!at) {
+		at = smem_part_find(sw.global_off, sw.global_size, sw.global_line, item, size);
+	}
+	if (!at && sw.smem_version == 11 && item < 512) {
+		uint32_t toc = 204 + 16 * item;          /* legacy: allocated, offset, size */
+		if (sm32(toc) == 1) {
+			at = sm32(toc + 4);
+			if (size) {
+				*size = sm32(toc + 8);
+			}
+		}
+	}
+	return at;
+}
+
+/* smp2p.c struct smp2p_smem_item: "$SMP", version|features, local/remote pid,
+ * total/valid entries, flags, then 16-byte names with a 32-bit value. */
+static uint32_t smp2p_last[16];
+
+static void
+smp2p_dump(unsigned item, const char *what, bool changes_only)
+{
+	uint32_t size = 0, at = smem_find(item, &size);
+	if (!at) {
+		if (!changes_only) {
+			wl_log("smp2p %s (item %u): absent", what, item);
+		}
+		return;
+	}
+	if (sm32(at) != 0x504d5324u) {
+		wl_log("smp2p %s: bad magic 0x%08x", what, sm32(at));
+		return;
+	}
+	uint32_t pids = sm32(at + 8), counts = sm32(at + 12);
+	unsigned valid = counts >> 16;
+	if (!changes_only) {
+		wl_log("smp2p %s: version/features 0x%08x pids %u->%u entries %u/%u flags 0x%x", what,
+		    sm32(at + 4), pids & 0xffffu, pids >> 16, valid, counts & 0xffffu, sm32(at + 16));
+	}
+	for (unsigned i = 0; i < valid && i < 16; ++i) {
+		uint32_t e = at + 20 + 20 * i;
+		char name[17] = { 0 };
+		sm_bytes(e, name, 16);
+		uint32_t v = sm32(e + 16);
+		if (!changes_only || v != smp2p_last[i]) {
+			wl_log("smp2p %s: %-16s 0x%08x", what, name, v);
+			smp2p_last[i] = v;
+		}
+	}
+}
+
+static void
+smem_report(bool changes_only)
+{
+	static const struct { unsigned item; const char *name; } items[] = {
+		{ SMEM_SMP2P_OUT, "smp2p apps->modem" },
+		{ SMEM_GLINK_DESC, "glink descriptor" },
+		{ SMEM_GLINK_FIFO0, "glink fifo0" },
+		{ SMEM_GLINK_FIFO1, "glink fifo1" },
+	};
+	static bool seen[4];
+	for (unsigned i = 0; i < 4; ++i) {
+		uint32_t size = 0, at = smem_find(items[i].item, &size);
+		if (!changes_only || (at != 0) != seen[i]) {
+			wl_log("smem item %u (%s): %s at 0x%x size 0x%x", items[i].item, items[i].name,
+			    at ? "present" : "absent", at, size);
+			seen[i] = at != 0;
+		}
+	}
+	smp2p_dump(SMEM_SMP2P_IN, "modem->apps", changes_only);
+	uint32_t size = 0, at = smem_find(SMEM_SSR_MSS, &size);
+	static uint32_t ssr_seen;
+	if (at && size && sm32(at) != ssr_seen) {
+		char reason[128] = { 0 };
+		sm_bytes(at, reason, size < sizeof(reason) - 1 ? size : sizeof(reason) - 1);
+		wl_log("modem SSR reason: %s", reason);
+		ssr_seen = sm32(at);
+	}
+}
+
+static void
+rails_report(void)
+{
+	static const char *const rails[] = { "cx.lvl", "mss.lvl", "ldoa9", "ldoc1", "ldoc2", "ldoc10", "ldoc11" };
+	for (unsigned i = 0; i < sizeof(rails) / sizeof(rails[0]); ++i) {
+		unsigned slave = 0, naux = 0;
+		uint32_t addr = 0;
+		uint16_t aux[16];
+		int err = sweet_rpmh_cmd_db(rails[i], &slave, &addr, aux, &naux, 16);
+		if (err) {
+			wl_log("cmd-db %s: error %d", rails[i], err);
+			continue;
+		}
+		char levels[96] = { 0 };
+		size_t len = 0;
+		for (unsigned j = 0; j < naux && len + 7 < sizeof(levels); ++j) {
+			len += (size_t)snprintf(levels + len, sizeof(levels) - len, " %u", aux[j]);
+		}
+		wl_log("cmd-db %s: slave %u addr 0x%x%s%s", rails[i], slave, addr, naux ? " levels" : "", levels);
+	}
+}
+
+/* Same SCM SMCCC caller as sweet_gpu.c. */
+static int64_t
+scm_call(uint32_t svc, uint32_t cmd, uint32_t arginfo, uint64_t a0, uint64_t a1, uint64_t a2,
+    uint64_t *result)
+{
+	uint64_t fn = 0x42000000ull | ((svc & 0xff) << 8) | (cmd & 0xff);
+	for (unsigned busy = 0; busy < 20; ++busy) {
+		uint64_t first = fn, session = 0;
+		register uint64_t x0 __asm__("x0");
+		register uint64_t x1 __asm__("x1");
+		register uint64_t x2 __asm__("x2");
+		register uint64_t x3 __asm__("x3");
+		register uint64_t x4 __asm__("x4");
+		register uint64_t x5 __asm__("x5");
+		register uint64_t x6 __asm__("x6");
+		register uint64_t x7 __asm__("x7");
+		do {
+			x0 = first;
+			x1 = arginfo;
+			x2 = a0;
+			x3 = a1;
+			x4 = a2;
+			x5 = 0;
+			x6 = session;
+			x7 = 0;
+			__asm__ volatile ("smc #0"
+			    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+			    :
+			    : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+			first = x0;
+			session = x6;
+		} while (x0 == 1);
+		if ((int64_t)x0 != -12) {
+			if (result) {
+				*result = x1;
+			}
+			return (int64_t)x0;
+		}
+		delay(30000);
+	}
+	return -12;
+}
+
+static vm_offset_t qmp, qmp_bell;
+
+static bool
+qmp_wait(uint32_t off, uint32_t want, unsigned ms)
+{
+	for (unsigned i = 0; i < ms; ++i) {
+		if (rd32(qmp, off) == want) {
+			return true;
+		}
+		delay(1000);
+	}
+	return false;
+}
+
+static void
+qmp_kick(void)
+{
+	wr32(qmp_bell, QMP_IPC, 1u << 0);
+}
+
+static void
+qmp_report(void)
+{
+	if (!qmp) {
+		qmp = ml_io_map(QMP_PA, QMP_SIZE);
+	}
+	if (!qmp) {
+		wl_log("qmp: map failed");
+		return;
+	}
+	wl_log("qmp: magic 0x%08x version %u features 0x%x", rd32(qmp, QMP_D_MAGIC), rd32(qmp, QMP_D_VERSION),
+	    rd32(qmp, QMP_D_FEATURES));
+	wl_log("qmp: ucore link 0x%08x/ack 0x%08x ch 0x%08x/ack 0x%08x mbox 0x%x+0x%x",
+	    rd32(qmp, QMP_D_UC_LINK), rd32(qmp, QMP_D_UC_LINK_ACK), rd32(qmp, QMP_D_UC_CH),
+	    rd32(qmp, QMP_D_UC_CH_ACK), rd32(qmp, QMP_D_UC_OFF), rd32(qmp, QMP_D_UC_SIZE));
+	wl_log("qmp: mcore link 0x%08x/ack 0x%08x ch 0x%08x/ack 0x%08x mbox 0x%x+0x%x",
+	    rd32(qmp, QMP_D_MC_LINK), rd32(qmp, QMP_D_MC_LINK_ACK), rd32(qmp, QMP_D_MC_CH),
+	    rd32(qmp, QMP_D_MC_CH_ACK), rd32(qmp, QMP_D_MC_OFF), rd32(qmp, QMP_D_MC_SIZE));
+}
+
+/* qcom_aoss.c qmp_open; an already open link (by an earlier boot stage) is reused. */
+static bool
+qmp_open(void)
+{
+	if (!qmp || rd32(qmp, QMP_D_MAGIC) != QMP_MAGIC || rd32(qmp, QMP_D_VERSION) != 1) {
+		wl_log("qmp: no usable descriptor");
+		return false;
+	}
+	if (!qmp_bell) {
+		qmp_bell = ml_io_map(QMP_DOORBELL_PA, 0x1000);
+	}
+	if (!qmp_bell) {
+		return false;
+	}
+	if (rd32(qmp, QMP_D_MC_CH_ACK) == QMP_UP && rd32(qmp, QMP_D_UC_CH) == QMP_UP) {
+		wl_log("qmp: channel already open");
+		return true;
+	}
+	wr32(qmp, QMP_D_UC_LINK_ACK, rd32(qmp, QMP_D_UC_LINK));
+	wr32(qmp, QMP_D_MC_LINK, QMP_UP);
+	qmp_kick();
+	if (!qmp_wait(QMP_D_MC_LINK_ACK, QMP_UP, 1000)) {
+		wl_log("qmp: link not acked");
+		return false;
+	}
+	wr32(qmp, QMP_D_MC_CH, QMP_UP);
+	qmp_kick();
+	if (!qmp_wait(QMP_D_UC_CH, QMP_UP, 1000)) {
+		wl_log("qmp: AOP channel not up");
+		return false;
+	}
+	wr32(qmp, QMP_D_UC_CH_ACK, QMP_UP);
+	qmp_kick();
+	if (!qmp_wait(QMP_D_MC_CH_ACK, QMP_UP, 1000)) {
+		wl_log("qmp: channel not acked");
+		return false;
+	}
+	wl_log("qmp: open");
+	return true;
+}
+
+static bool
+qmp_send(const char *msg)
+{
+	uint32_t off = rd32(qmp, QMP_D_MC_OFF), size = rd32(qmp, QMP_D_MC_SIZE);
+	size_t len = (strlen(msg) + 1 + 3) & ~(size_t)3;
+	if (len + 4 > size || off + size > QMP_SIZE) {
+		wl_log("qmp: message too long (%zu, mbox %u)", len, size);
+		return false;
+	}
+	size_t slen = strlen(msg);
+	for (size_t i = 0; i < len; i += 4) {
+		uint32_t w = 0;
+		for (size_t b = 0; b < 4 && i + b < slen; ++b) {
+			w |= (uint32_t)(uint8_t)msg[i + b] << (8 * b);
+		}
+		wr32(qmp, off + 4 + (uint32_t)i, w);
+	}
+	wr32(qmp, off, (uint32_t)len);
+	qmp_kick();
+	bool ok = qmp_wait(off, 0, 1000);
+	wl_log("qmp: \"%s\" %s", msg, ok ? "consumed" : "NOT consumed in 1 s");
+	return ok;
+}
+
+static bool
+wl_open(const char *path, vnode_t *vp, off_t *size, vfs_context_t ctx)
+{
+	int err = vnode_open(path, FREAD, 0, 0, vp, ctx);
+	if (!err) {
+		err = vnode_size(*vp, size, ctx);
+		if (err) {
+			(void)vnode_close(*vp, FREAD, ctx);
+		}
+	}
+	if (err) {
+		wl_log("cannot open %s: %d", path, err);
+	}
+	return !err;
+}
+
+/* Reads a whole small file (the .mdt). */
+static uint8_t *
+wl_read_small(const char *path, size_t max, size_t *len)
+{
+	vfs_context_t ctx = vfs_context_create(NULL);
+	vnode_t vp = NULLVP;
+	off_t size = 0;
+	uint8_t *buf = NULL;
+	if (wl_open(path, &vp, &size, ctx)) {
+		int resid = 0;
+		if (size > 0 && (size_t)size <= max && (buf = kalloc_data((vm_size_t)size, Z_WAITOK | Z_ZERO))) {
+			if (vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)size, 0, UIO_SYSSPACE, 0, vfs_context_ucred(ctx),
+			    &resid, vfs_context_proc(ctx)) || resid) {
+				kfree_data(buf, (vm_size_t)size);
+				buf = NULL;
+			} else {
+				*len = (size_t)size;
+			}
+		}
+		(void)vnode_close(vp, FREAD, ctx);
+	}
+	(void)vfs_context_rele(ctx);
+	return buf;
+}
+
+#define WL_WINDOW (1u << 20)
+
+/* Writes N bytes (N <= WL_WINDOW; zeros when SRC is NULL) at physical PA
+ * through a temporary device mapping: the 132 MiB region at once does not
+ * fit the kernel's I/O map. 8-byte stores, byte stores at the edges
+ * (device memory takes no unaligned access). */
+static bool
+wl_put(uint64_t pa, const uint8_t *src, uint32_t n)
+{
+	uint64_t base = trunc_page_64(pa);
+	vm_size_t len = round_page_64(pa + n) - base;
+	/* ml_io_map entries are permanent; only this kind may be unmapped. */
+	vm_offset_t va = ml_io_map_unmappable((vm_offset_t)base, len, VM_WIMG_IO);
+	if (!va) {
+		return false;
+	}
+	vm_offset_t dst = va + (vm_offset_t)(pa - base);
+	uint32_t i = 0;
+	for (; i < n && ((dst + i) & 7); ++i) {
+		*(volatile uint8_t *)(dst + i) = src ? src[i] : 0;
+	}
+	for (; i + 8 <= n; i += 8) {
+		uint64_t v = 0;
+		if (src) {
+			memcpy(&v, src + i, 8);
+		}
+		*(volatile uint64_t *)(dst + i) = v;
+	}
+	for (; i < n; ++i) {
+		*(volatile uint8_t *)(dst + i) = src ? src[i] : 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	ml_io_unmap(va, len);
+	return true;
+}
+
+/* Streams a segment file to physical PA, a window at a time. */
+static bool
+wl_load_segment(const char *path, uint64_t pa, uint32_t filesz)
+{
+	const size_t chunk = WL_WINDOW;
+	vfs_context_t ctx = vfs_context_create(NULL);
+	vnode_t vp = NULLVP;
+	off_t size = 0;
+	bool ok = false;
+	uint8_t *buf = kalloc_data(chunk, Z_WAITOK);
+	if (buf && wl_open(path, &vp, &size, ctx)) {
+		if (size != (off_t)filesz) {
+			wl_log("%s: %lld bytes, want %u", path, (long long)size, filesz);
+		} else {
+			ok = true;
+			for (uint32_t pos = 0; ok && pos < filesz; pos += chunk) {
+				uint32_t n = filesz - pos < chunk ? filesz - pos : (uint32_t)chunk;
+				int resid = 0;
+				if (vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)n, pos, UIO_SYSSPACE, 0, vfs_context_ucred(ctx),
+				    &resid, vfs_context_proc(ctx)) || resid) {
+					wl_log("%s: read error at %u", path, pos);
+					ok = false;
+					break;
+				}
+				if (!wl_put(pa + pos, buf, n)) {
+					wl_log("%s: map failed at %u", path, pos);
+					ok = false;
+					break;
+				}
+			}
+		}
+		(void)vnode_close(vp, FREAD, ctx);
+	}
+	if (buf) {
+		kfree_data(buf, chunk);
+	}
+	(void)vfs_context_rele(ctx);
+	return ok;
+}
+
+static bool
+wl_zero(uint64_t pa, uint32_t from, uint32_t to)
+{
+	for (uint32_t pos = from; pos < to; ) {
+		uint32_t n = to - pos < WL_WINDOW ? to - pos : WL_WINDOW;
+		if (!wl_put(pa + pos, NULL, n)) {
+			return false;
+		}
+		pos += n;
+	}
+	return true;
+}
+
+/* The proxy votes of pil-tz / qcom_q6v5_pas: the smallest ARC level at or
+ * above TURBO (or the highest there is). */
+static bool
+wl_arc_turbo(const char *res)
+{
+	unsigned slave = 0, naux = 0;
+	uint32_t addr = 0;
+	uint16_t aux[16];
+	if (sweet_rpmh_cmd_db(res, &slave, &addr, aux, &naux, 16) || slave != 3 || !naux) {
+		wl_log("%s: no ARC levels", res);
+		return false;
+	}
+	unsigned hlvl = naux - 1;
+	for (unsigned i = 0; i < naux; ++i) {
+		if (aux[i] >= TURBO_VLVL) {
+			hlvl = i;
+			break;
+		}
+	}
+	int err = sweet_rpmh_arc_vote(res, hlvl);
+	wl_log("vote %s hlvl %u (vlvl %u): %d", res, hlvl, aux[hlvl], err);
+	return !err;
+}
+
+static bool
+wl_modem_boot(void)
+{
+	uint64_t res = 0;
+	size_t mdt_len = 0;
+	uint8_t *mdt = wl_read_small(MSS_FW_DIR "modem.mdt", MSS_MDT_MAX, &mdt_len);
+	if (!mdt) {
+		return false;
+	}
+	bool ok = false;
+	vm_offset_t meta = 0;
+	uint32_t phnum = mdt_len >= 52 ? *(const uint16_t *)(mdt + 44) : 0;
+	uint32_t phoff = mdt_len >= 52 ? *(const uint32_t *)(mdt + 28) : 0;
+	uint32_t min_pa = ~0u, max_end = 0;
+	if (mdt_len < 52 || memcmp(mdt, "\x7f" "ELF", 4) || mdt[4] != 1 || phnum > 64 ||
+	    phoff + phnum * 32u > mdt_len) {
+		wl_log("modem.mdt: not an ELF32 image");
+		goto out;
+	}
+	for (uint32_t i = 0; i < phnum; ++i) {
+		const uint32_t *ph = (const uint32_t *)(mdt + phoff + 32 * i);
+		if (ph[0] != 1 || (ph[6] & 0x07000000u) == 0x02000000u || !ph[5]) {
+			continue;
+		}
+		min_pa = ph[3] < min_pa ? ph[3] : min_pa;
+		uint32_t end = (ph[3] + ph[5] + 0xfffu) & ~0xfffu;
+		max_end = end > max_end ? end : max_end;
+	}
+	if (min_pa != MSS_PA || max_end <= min_pa || max_end - min_pa > MSS_SIZE) {
+		wl_log("modem.mdt: segments 0x%x-0x%x outside pil_modem_mem", min_pa, max_end);
+		goto out;
+	}
+	wl_log("modem.mdt: %u program headers, image 0x%x-0x%x", phnum, min_pa, max_end);
+
+	/* Power first: AOP's load_state, then the proxy votes. */
+	if (!qmp_open() || !qmp_send("{class: image, res: load_state, name: modem, val: on}")) {
+		goto out;
+	}
+	if (!wl_arc_turbo("cx.lvl") || !wl_arc_turbo("mss.lvl")) {
+		goto out;
+	}
+
+	if (kmem_alloc_contig(kernel_map, &meta, round_page(mdt_len), PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		goto out;
+	}
+	memcpy((void *)meta, mdt, mdt_len);
+	uint64_t meta_pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)meta));
+	flush_dcache64((addr64_t)meta_pa, (unsigned)round_page(mdt_len), TRUE);
+	int64_t rc = scm_call(2, 1, 0x82, MSS_PAS_ID, meta_pa, 0, &res);      /* PAS_INIT_IMAGE */
+	wl_log("scm pas_init_image: rc %lld result %llu (metadata %zu bytes at 0x%llx)", rc, res, mdt_len, meta_pa);
+	if (rc || res) {
+		goto out;
+	}
+	rc = scm_call(2, 2, 3, MSS_PAS_ID, MSS_PA, max_end - min_pa, &res);    /* PAS_MEM_SETUP */
+	wl_log("scm pas_mem_setup(0x%x, 0x%x): rc %lld result %llu", MSS_PA, max_end - min_pa, rc, res);
+	if (rc || res) {
+		goto out;
+	}
+	uint64_t t0 = mach_absolute_time();
+	uint32_t loaded = 0;
+	for (uint32_t i = 0; i < phnum; ++i) {
+		const uint32_t *ph = (const uint32_t *)(mdt + phoff + 32 * i);
+		if (ph[0] != 1 || (ph[6] & 0x07000000u) == 0x02000000u || !ph[5]) {
+			continue;
+		}
+		uint32_t off = ph[3] - min_pa, filesz = ph[4], memsz = ph[5];
+		if (filesz > memsz) {
+			wl_log("segment %u: filesz 0x%x > memsz 0x%x", i, filesz, memsz);
+			goto out;
+		}
+		if (filesz) {
+			char name[96];
+			snprintf(name, sizeof(name), MSS_FW_DIR "modem.b%02u", i);
+			if (!wl_load_segment(name, (uint64_t)MSS_PA + off, filesz)) {
+				goto out;
+			}
+			loaded += filesz;
+		}
+		if (!wl_zero((uint64_t)MSS_PA + off, filesz, memsz)) {
+			wl_log("segment %u: zero fill failed", i);
+			goto out;
+		}
+	}
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	wl_log("modem segments loaded: %u bytes in %llu ms", loaded, ns / 1000000);
+	t0 = mach_absolute_time();
+	rc = scm_call(2, 5, 1, MSS_PAS_ID, 0, 0, &res);                       /* PAS_AUTH_AND_RESET */
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	wl_log("scm pas_auth_and_reset: rc %lld result %llu (%llu ms)", rc, res, ns / 1000000);
+	ok = !rc && !res;
+out:
+	kfree_data(mdt, mdt_len);
+	return ok;
+}
+
+static int sweet_wlan_sleep_chan;
+
+static void
+wl_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&sweet_wlan_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+wl_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	wl_sleep_ms((unsigned)sw.delay_s * 1000u);
+	wl_log("stage %d", sw.stage);
+	sw.smem = ml_io_map(SMEM_PA, SMEM_SIZE);
+	if (!sw.smem) {
+		wl_log("smem map failed");
+		return;
+	}
+	if (!smem_scan()) {
+		return;
+	}
+	smem_report(false);
+	rails_report();
+	qmp_report();
+	uint64_t res = 0;
+	int64_t rc = scm_call(2, 7, 1, MSS_PAS_ID, 0, 0, &res);           /* PAS_IS_SUPPORTED */
+	wl_log("scm pas_is_supported(%u): rc %lld result %llu", MSS_PAS_ID, rc, res);
+	size_t len = 0;
+	uint8_t *probe = wl_read_small(MSS_FW_DIR "modem.mdt", MSS_MDT_MAX, &len);
+	wl_log("firmware: modem.mdt %s (%zu bytes)", probe ? "found" : "missing", len);
+	if (probe) {
+		kfree_data(probe, len);
+	}
+	if (sw.stage < 2) {
+		wl_log("done");
+		return;
+	}
+	if (!wl_modem_boot()) {
+		wl_log("modem boot failed");
+		return;
+	}
+	for (unsigned t = 0; t < 300; ++t) {               /* 30 s */
+		wl_sleep_ms(100);
+		smem_report(true);
+	}
+	smem_report(false);
+	qmp_report();
+	wl_log("done");
+}
+
+void
+sweet_wlan_probe(void)
+{
+	thread_t thread;
+	sw.stage = 0;
+	sw.delay_s = 30;
+	PE_parse_boot_argn("sweetwlan", &sw.stage, sizeof(sw.stage));
+	PE_parse_boot_argn("sweetwlandelay", &sw.delay_s, sizeof(sw.delay_s));
+	if (sw.stage <= 0 || !wl_is_joyeuse()) {
+		return;
+	}
+	if (sw.delay_s < 0) {
+		sw.delay_s = 0;
+	}
+	if (kernel_thread_start(wl_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET WLAN: kernel_thread_start failed\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
