+/* Any slave (ARC 3, VRM 4, BCM 5): its address and aux data (ARC: the
+ * levels, little-endian 16-bit). Read-only; the caller holds rh_lock. */
+static int
+rh_find(const char *res, unsigned *slave_out, uint32_t *address, uint32_t *aux_off, uint32_t *aux_len)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	unsigned matches = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) ||
+		    !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16);
+			uint32_t off = aux + rh_db16(e + 22), len = rh_db16(e + 20);
+			if ((addr >> 16) != slave || !rh_range(off, len)) {
+				return EINVAL;
+			}
+			*slave_out = slave;
+			*address = addr;
+			*aux_off = off;
+			*aux_len = len;
+			++matches;
+		}
+	}
+	return matches == 1 ? 0 : ENODEV;
+}
