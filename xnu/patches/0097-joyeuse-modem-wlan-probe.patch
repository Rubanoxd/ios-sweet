+/*
+ * JOYEUSE: Wi-Fi bring-up, staged like the GPU (bsd/dev/sweet_gpu.c).
+ *
+ * The SM7125 WLAN is integrated (ICNSS, WCN3990 RF over SNOC at 0x18800000)
+ * and its firmware (wlanmdsp.mbn) runs inside the modem DSP, which reaches
+ * the apps side over SMEM, SMP2P and GLINK/QRTR. So the first thing Wi-Fi
+ * needs is the modem running. Addresses from the stock MIUI joyeuse DT
+ * (downstream atoll kernel) and Linux qcom_smem.c, smp2p.c, qcom_aoss.c,
+ * qcom_q6v5_pas.c, mdt_loader.c:
+ *   modem   "qcom,pil-tz-generic", PAS id 4, firmware "modem" (.mdt + .bNN,
+ *           relocatable) into pil_modem_mem 0x86000000 + 0x8400000; proxy
+ *           votes cx.lvl and mss.lvl (TURBO), "qcom,signal-aop" (AOP QMP
+ *           load_state message)
+ *   SMEM    0x80900000 + 2 MiB; SMP2P with the modem: inbound item 435,
+ *           outbound 428, IRQ SPI 451; SSR reason item 421; GLINK native
+ *           xprt items 478-480
+ *   AOP QMP msgram 0xc300000, doorbell APCS IPC 0x17c0000c bit 0
+ *   WLAN    0x18800000 (not touched here), MSA 0x93900000 + 2 MiB,
+ *           supplies ldoa9 (cx/mx), ldoc1 (1.8 xo), ldoc2 (1.3 rfa),
+ *           ldoc10/ldoc11 (3.3 ch0/ch1)
+ *
+ * Boot-arg sweetwlan=<stage> (default 0 = off), each includes the previous:
+ *   1  read-only: SMEM header and partitions, the SMEM items above, the
+ *      cmd-db entries of the rails above, the AOP QMP descriptor, SCM
+ *      PAS_IS_SUPPORTED(4) and the modem firmware files
+ *   2  boot the modem: AOP load_state, cx/mss proxy votes, PAS init, mem
+ *      setup, segment load and auth_and_reset from
+ *      /usr/share/firmware/joyeuse/modem/, then 30 s of watching SMP2P and
+ *      SMEM (the modem's smp2p entries, the SSR reason, GLINK items)
+ * After auth_and_reset the modem region belongs to the modem (an apps access
+ * faults on the XPU): nothing here touches it again.
+ * It runs sweetwlandelay seconds (default 30) after boot on its own thread;
+ * lines go to the console and to sysctl kern.sweetwlan. joyeuse only.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
