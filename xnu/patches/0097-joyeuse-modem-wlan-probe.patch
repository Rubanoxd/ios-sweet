+	printf("SWEET WLAN: %s\n", line);
+	size_t len = strnlen(line, sizeof(line));
+	if (sweet_wlan_log_len + len + 2 <= sizeof(sweet_wlan_log)) {
+		memcpy(sweet_wlan_log + sweet_wlan_log_len, line, len);
+		sweet_wlan_log_len += len;
