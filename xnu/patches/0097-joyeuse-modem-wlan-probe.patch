+		return EBUSY;
+	}
+	unsigned slave = 0;
+	uint32_t address = 0, off = 0, len = 0;
+	int error = EIO;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_find(res, &slave, &address, &off, &len);
+	}
+	if (!error && (slave != RH_ARC || hlvl >= len / 2)) {
+		error = EINVAL;
+	}
+	if (!error) {
+		error = rh_send_cmds(&address, &hlvl, 1, res);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: %s level %u vote failed errno=%d\n", res, hlvl, error);
 	}
 	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
 	return error;
