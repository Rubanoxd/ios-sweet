+/* Read-only cmd-db lookup for other drivers (bsd/dev/sweet_wlan.c). */
+int
+sweet_rpmh_cmd_db(const char *res, unsigned *slave, uint32_t *addr, uint16_t *aux, unsigned *naux, unsigned max)
+{
+	if (!res || !slave || !addr || !naux || (max && !aux)) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	uint32_t off = 0, len = 0;
+	int error = rh_map();
+	if (!error) {
+		error = rh_find(res, slave, addr, &off, &len);
+	}
+	if (!error) {
+		*naux = 0;
+		for (uint32_t i = 0; i + 2 <= len && *naux < max; i += 2) {
+			aux[(*naux)++] = rh_db16(off + i);
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
