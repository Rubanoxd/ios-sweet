--- a/osfmk/arm64/sweet_tdump.c
+++ b/osfmk/arm64/sweet_tdump.c
@@ -11,6 +11,11 @@
  *     interrupt taken in the kernel (kpcb) for a thread that never blocks.
  * Kernel addresses are printed unslid (VM_KERNEL_UNSLIDE) for symbolication
  * against the kernel file.
+ * xnu 0099: also each thread's run queue, bound and chosen processor, and,
+ * twice 20 ms apart, every CPU's state, active thread, interrupt counters
+ * and the pc of its last interrupt (cpu_int_state), which shows where a
+ * thread that spins in the kernel is. Lines are paced (1 ms) so the USB log
+ * does not drop them.
  */
 #include <kern/thread.h>
 #include <kern/task.h>
@@ -18,6 +23,7 @@
 #include <kern/misc_protos.h>
 #include <mach/vm_param.h>
 #include <kern/clock.h>
+#include <arm/cpu_data_internal.h>
 
 #if defined(SWEET)
 
@@ -72,6 +78,9 @@
 		    thread_tid(th), name, th->state, th->sched_pri,
 		    (unsigned long long)VM_KERNEL_UNSLIDE_OR_PERM(th->wait_event),
 		    last ? last->cpu_id : -1, th == current_thread() ? " (this thread)" : "");
+		printf("SWEET TDUMP:   runq %d bound %d chosen %d mode %d\n",
+		    th->runq ? th->runq->cpu_id : -1, th->bound_processor ? th->bound_processor->cpu_id : -1,
+		    th->chosen_processor ? th->chosen_processor->cpu_id : -1, (int)th->sched_mode);
 		if (th->machine.upcb != NULL) {
 			arm_saved_state_t *u = th->machine.upcb;
 			printf("SWEET TDUMP:   user pc %llx lr %llx x16 %lld\n",
@@ -90,8 +99,25 @@
 			    (unsigned long long)VM_KERNEL_UNSLIDE(get_saved_state_pc(k)));
 			sweet_tdump_frames(th, get_saved_state_fp(k), get_saved_state_lr(k), "irq");
 		}
+		delay(1000);
 	}
 	task_unlock(task);
+	for (int round = 0; round < 2; round++) {
+		for (processor_t p = processor_list; p != PROCESSOR_NULL; p = p->processor_list) {
+			cpu_data_t *cd = cpu_datap(p->cpu_id);
+			thread_t act = p->active_thread;
+			uint64_t pc = 0;
+			if (cd != NULL && cd->cpu_int_state != NULL) {
+				pc = VM_KERNEL_UNSLIDE(get_saved_state_pc((arm_saved_state_t *)cd->cpu_int_state));
+			}
+			printf("SWEET TDUMP: cpu %d state %d active %llu irq %llu ipi %llu timer %llu last-irq pc %llx\n",
+			    p->cpu_id, (int)p->state, act ? thread_tid(act) : 0ULL,
+			    cd ? cd->cpu_stat.irq_ex_cnt : 0ULL, cd ? cd->cpu_stat.ipi_cnt : 0ULL,
+			    cd ? cd->cpu_stat.timer_cnt : 0ULL, (unsigned long long)pc);
+			delay(1000);
+		}
+		delay(20000);
+	}
 	printf("SWEET TDUMP: done\n");
 }
 
