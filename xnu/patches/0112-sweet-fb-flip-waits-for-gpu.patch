+int64_t
+sweet_surface_use_count(uint32_t id)
+{
+	SweetSurface *s = sweet_surface_copy(id);
+	if (s == NULL) {
+		return 0;
+	}
+	int64_t count = *(volatile SInt64 *)((uint8_t *)s->state->getBytesNoCopy() + SWEET_SURFACE_STATE_USE_COUNT);
+	s->release();
+	return count;
+}
