+static uint64_t sweet_fb_wait_since, sweet_fb_gpu_waits, sweet_fb_gpu_timeouts;
+
+/* xnu 0112: a layer of the frame is still being drawn or read by the GPU. */
+static bool
+sweet_fb_gpu_busy(const uint8_t *rec)
+{
+	uint32_t mask;
+	memcpy(&mask, rec + 0x104, 4);
+	for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+		uint32_t id;
+		memcpy(&id, rec + 0x54 + 4 * layer, 4);
+		if ((mask & (1u << layer)) && id != 0 && sweet_surface_use_count(id) > 0) {
+			return true;
+		}
+	}
+	return false;
+}
