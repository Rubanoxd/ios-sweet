-/* Logs every change of the GX/GMU power state for the first ten minutes. */
+/*
+ * Hang recovery, lighter than Linux's a6xx_recover (which power-cycles CX
+ * and reboots the GMU): halt the SQE, drain the GBIF
+ * (a6xx_bus_clear_pending_transactions), pulse RBBM_SW_RESET_CMD
+ * (a6xx_gpu_sw_reset), then hw_init, the CP start and the secure-mode exit
+ * again. The GMU and the SMMU tables stay. Every job in flight is retired
+ * as lost and the fault count moves, which Turnip reports as device lost.
+ * Called with gpu_mtx held.
+ */
+static uint64_t gpu_recoveries;
+
+static bool
+gpu_recover(const char *why)
+{
+	gpu_log("recover (%s): rptr %u wptr %u rbbm_status 0x%08x int0 0x%08x cp_hw_fault 0x%08x "
+	    "cp_int 0x%08x, fence %u of %u", why, core_rd(0x0806), rb_wptr, core_rd(0x0210),
+	    core_rd(0x0201), core_rd(0x0821), core_rd(0x0823), sweet_gpu_retired(), gpu_seqno);
+	gpu_smmu_faults(gfx_smmu, SMMU_GFX_IDX);
+	core_wr(0x0808, 3);                           /* CP_SQE_CNTL: halt */
+	core_wr(0x0016, 1);                           /* RBBM_GBIF_HALT: GX side */
+	bool drained = gpu_wait(gpu_core, 0x0017 << 2, 1, 1, 1000);
+	core_wr(0x3c45, 1);                           /* GBIF_HALT: client requests */
+	drained &= gpu_wait(gpu_core, 0x3c46 << 2, 1, 1, 1000);
+	core_wr(0x3c45, 2);                           /* GBIF_HALT: AXI arbiter */
+	drained &= gpu_wait(gpu_core, 0x3c46 << 2, 2, 2, 1000);
+	core_wr(0x3c45, 0);
+	core_wr(0x0043, 1);                           /* RBBM_SW_RESET_CMD */
+	(void)core_rd(0x0043);
+	delay(100);
+	core_wr(0x0043, 0);
+	(void)core_rd(0x0043);
+	delay(1);
+	gpu_hw_init();
+	gpu_irq.err_status = 0;
+	gpu_irq.mask = RBBM_INT_MASK;
+	core_wr(0x0037, 0xffffffffu);                 /* RBBM_INT_CLEAR_CMD */
+	core_wr(0x0038, gpu_irq.mask);
+	bool ok = gpu_cp_start("recover: cp me_init");
+	if (ok && gpu_zap_ok) {
+		rb_pkt7(CP_SET_SECURE_MODE, 1);
+		rb_out(0);
+		ok = rb_kick("recover: set_secure_mode 0");
+	}
+	*(volatile uint32_t *)(gfx_mem + GMU_TABLES + GPU_FENCE_OFF) = gpu_seqno;
+	flush_dcache64((addr64_t)(gfx_mem_pa + GMU_TABLES + GPU_FENCE_OFF), 64, TRUE);
+	gpu_fault_count++;
+	gpu_recoveries++;
+	if (gpu_irq.storm) {
+		gpu_irq.storm = false;
+		sweet_irq_enable(GPU_INTID, true);
+	}
+	thread_wakeup(&gpu_irq_chan);
+	gpu_log("recover #%llu: GBIF %s, %s", gpu_recoveries, drained ? "drained" : "did not drain",
+	    ok ? "GPU running again" : "FAILED, GPU disabled");
+	if (!ok) {
+		gpu_ready = false;
+	}
+	return ok;
+}
