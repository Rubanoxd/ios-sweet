+ * frontend so: it then delivers QuartzCore's "scheduled" at submission
+ * instead of holding it until the GPU completes (xnu 0114).
+ */
+static int sweet_fb_gpu_wait = 1;
+SYSCTL_INT(_kern, OID_AUTO, sweet_fb_gpu_wait, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &sweet_fb_gpu_wait, 0, "the display flip waits for the GPU");
