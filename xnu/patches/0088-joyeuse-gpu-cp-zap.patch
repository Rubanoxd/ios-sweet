+/* adreno_gpu.c zap_shader_load_mdt + mdt_loader.c for the split a615_zap
+ * (metadata = ELF header + hash segment, i.e. the whole .mdt; one
+ * relocatable PT_LOAD segment in .b02), then qcom_scm_pas_auth_and_reset. */
+static bool
+gpu_zap_load(void)
+{
+	uint64_t res = 0;
+	int64_t rc = scm_call(2, 7, 1, GPU_PAS_ID, 0, 0, &res);    /* PAS_IS_SUPPORTED */
+	/* On hardware this answers 0 for the GPU (TZ, with the hypervisor in
+	 * front); Android's pil-tz loader still goes ahead, so only log it. */
+	gpu_log("scm pas_is_supported(%u): rc %lld result %llu", GPU_PAS_ID, rc, res);
+	uint8_t *mdt = NULL, *seg = NULL;
+	size_t mdt_len = 0, seg_len = 0;
+	if (gpu_load_file("/usr/share/firmware/joyeuse/gpu/a615_zap.mdt", &mdt, &mdt_len)) {
+		return false;
+	}
+	bool ok = false;
+	vm_offset_t meta = 0, zap = 0;
+	uint32_t phnum = *(const uint16_t *)(mdt + 44), phoff = *(const uint32_t *)(mdt + 28);
+	uint32_t seg_pa = 0, seg_memsz = 0, seg_filesz = 0, seg_index = 0, min_pa = ~0u, max_end = 0;
+	if (mdt_len < 52 || memcmp(mdt, "\x7f" "ELF", 4) || mdt[4] != 1 ||
+	    phoff + phnum * 32u > mdt_len) {
+		gpu_log("a615_zap.mdt: not an ELF32 image");
+		goto out;
+	}
+	for (uint32_t i = 0; i < phnum; ++i) {
+		const uint32_t *ph = (const uint32_t *)(mdt + phoff + 32 * i);
+		/* PT_LOAD, not the hash segment, non-empty (mdt_phdr_valid) */
+		if (ph[0] != 1 || (ph[6] & 0x07000000u) == 0x02000000u || !ph[5]) {
+			continue;
+		}
+		seg_index = i;
+		seg_pa = ph[3];
+		seg_filesz = ph[4];
+		seg_memsz = ph[5];
+		min_pa = seg_pa < min_pa ? seg_pa : min_pa;
+		uint32_t end = (seg_pa + seg_memsz + 0xfffu) & ~0xfffu;
+		max_end = end > max_end ? end : max_end;
+	}
+	if (min_pa != seg_pa || max_end - min_pa > ZAP_SIZE || seg_filesz > seg_memsz) {
+		gpu_log("a615_zap.mdt: unexpected segments (pa 0x%x memsz 0x%x)", seg_pa, seg_memsz);
+		goto out;
+	}
+	/* The metadata must be physically contiguous; TZ protects it during the
+	 * call, so the CPU never touches it again afterwards. */
+	if (kmem_alloc_contig(kernel_map, &meta, round_page(mdt_len), PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		goto out;
+	}
+	memcpy((void *)meta, mdt, mdt_len);
+	uint64_t meta_pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)meta));
+	flush_dcache64((addr64_t)meta_pa, (unsigned)round_page(mdt_len), TRUE);
+	rc = scm_call(2, 1, 0x82, GPU_PAS_ID, meta_pa, 0, &res);      /* PAS_INIT_IMAGE */
+	gpu_log("scm pas_init_image: rc %lld result %llu (metadata %zu bytes at 0x%llx)", rc, res,
+	    mdt_len, meta_pa);
+	if (rc || res) {
+		goto out;
+	}
+	rc = scm_call(2, 2, 3, GPU_PAS_ID, ZAP_PA, max_end - min_pa, &res);  /* PAS_MEM_SETUP */
+	gpu_log("scm pas_mem_setup(0x%x, 0x%x): rc %lld result %llu", ZAP_PA, max_end - min_pa, rc, res);
+	if (rc || res) {
+		goto out;
+	}
+	char name[64];
+	snprintf(name, sizeof(name), "/usr/share/firmware/joyeuse/gpu/a615_zap.b%02u", seg_index);
+	if (gpu_load_file(name, &seg, &seg_len) || seg_len != seg_filesz) {
+		gpu_log("%s: %zu bytes, want %u", name, seg_len, seg_filesz);
+		goto out;
+	}
+	zap = ml_io_map(ZAP_PA, ZAP_SIZE);
+	if (!zap) {
+		goto out;
+	}
+	for (uint32_t i = 0; i < seg_memsz; i += 4) {
+		uint32_t v = 0;
+		if (i < seg_filesz) {
+			memcpy(&v, seg + i, seg_filesz - i >= 4 ? 4 : seg_filesz - i);
+		}
+		gpu_wr(zap, i, v);
+	}
+	rc = scm_call(2, 5, 1, GPU_PAS_ID, 0, 0, &res);                /* PAS_AUTH_AND_RESET */
+	gpu_log("scm pas_auth_and_reset: rc %lld result %llu", rc, res);
+	ok = !rc && !res;
+out:
+	if (seg) {
+		kfree_data(seg, seg_len);
+	}
+	kfree_data(mdt, mdt_len);
+	return ok;
 }
 
+static void
+gpu_gfx_tables(void)
+{
+	uint64_t *l1 = (uint64_t *)gfx_mem;
+	uint64_t *l2 = (uint64_t *)(gfx_mem + 0x1000);
+	uint64_t *l3 = (uint64_t *)(gfx_mem + 0x2000);
+	l1[(GFX_IOVA >> 30) & 0x3] = (gfx_mem_pa + 0x1000) | 0x3;
+	l2[(GFX_IOVA >> 21) & 0x1ff] = (gfx_mem_pa + 0x2000) | 0x3;
+	for (uint32_t i = 0; i < GFX_MEM_SIZE / 0x1000; ++i) {
+		l3[((GFX_IOVA >> 12) & 0x1ff) + i] = (gfx_mem_pa + GMU_TABLES + i * 0x1000ull) |
+		    0x3 | (1ull << 6) | (2ull << 8) | (1ull << 10) | (1ull << 11);
+	}
+}
