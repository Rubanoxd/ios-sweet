+static bool
+gpu_stage_cp(vm_offset_t smmu)
+{
+	gpu_core = ml_io_map(0x05000000u, 0x40000);
+	uint8_t *sqe = NULL;
+	size_t sqe_len = 0;
+	if (!gpu_core || gpu_load_file("/usr/share/firmware/joyeuse/gpu/a630_sqe.fw", &sqe, &sqe_len)) {
+		return false;
+	}
+	/* adreno_fw_create_bo drops the first dword; a6xx_ucode_check_version
+	 * wants a630 microcode >= 0x190 (or a patched one). */
+	uint32_t ver = *(const uint32_t *)(sqe + 4);
+	gpu_log("a630_sqe.fw: %zu bytes, version 0x%03x", sqe_len, ver & 0xfff);
+	if (sqe_len - 4 > 0x8000 || ((ver & 0xfff) < 0x190 && !((ver & 0xf) == 0xa))) {
+		kfree_data(sqe, sqe_len);
+		return false;
+	}
+	if (kmem_alloc_contig(kernel_map, &gfx_mem, GMU_TABLES + GFX_MEM_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		kfree_data(sqe, sqe_len);
+		return false;
+	}
+	gfx_mem_pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)gfx_mem));
+	memcpy((void *)(gfx_mem + GMU_TABLES + GFX_SQE_OFF), sqe + 4, sqe_len - 4);
+	kfree_data(sqe, sqe_len);
+	gpu_gfx_tables();
+	flush_dcache64((addr64_t)gfx_mem_pa, GMU_TABLES + GFX_MEM_SIZE, TRUE);
+	if (!gpu_smmu_bank(smmu, SMMU_GFX_IDX, SMMU_GFX_SID, gfx_mem_pa)) {
+		return false;
+	}
+
+	/* hw_init (a6xx_gpu.c) for a618: no hwcg, CP protect or UBWC yet. */
+	core_wr(0x3c45, 0);                       /* GBIF_HALT */
+	(void)core_rd(0x3c45);
+	core_wr(0x0016, 0);                       /* RBBM_GBIF_HALT */
+	(void)core_rd(0x0016);
+	core_wr(0xf803, 0);                       /* RBBM_SECVID_TSB_CNTL */
+	core_wr64(0xf800, 0);                     /* RBBM_SECVID_TSB_TRUSTED_BASE */
+	core_wr(0xf802, 0);                       /* RBBM_SECVID_TSB_TRUSTED_SIZE */
+	static const uint16_t addr_mode[] = { 0x0842, 0x0c01, 0x8601, 0x8e05, 0x9e01, 0xbe05,
+		                              0xa601, 0x9601, 0x0e00, 0xae01, 0xb601, 0xf810 };
+	for (unsigned i = 0; i < sizeof(addr_mode) / sizeof(addr_mode[0]); ++i) {
+		core_wr(addr_mode[i], 1);             /* *_ADDR_MODE_CNTL: 64-bit */
+	}
+	core_wr(0x0010, 0x3);                     /* RBBM_VBIF_CLIENT_QOS_CNTL */
+	core_wr(0x050b, 0xffffffffu);             /* RBBM_PERFCTR_GPU_BUSY_MASKED */
+	core_wr64(0x0e05, 0x0001ffffffffffc0ull); /* UCHE_WRITE_RANGE_MAX */
+	core_wr64(0x0e09, 0x0001fffffffff000ull); /* UCHE_TRAP_BASE */
+	core_wr64(0x0e07, 0x0001fffffffff000ull); /* UCHE_WRITE_THRU_BASE */
+	core_wr64(0x0e0b, 0x100000);              /* UCHE_GMEM_RANGE_MIN */
