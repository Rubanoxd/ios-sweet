+/* Stage 6: the GPU's SMMU context, a6xx hw_init, CP start, zap shader. */
+
+/* GPU memory (context bank 0, stream 0: the DT's gfx3d_user): page tables,
+ * then the ring, the SQE microcode and a scratch page, at GFX_IOVA. */
+#define GFX_IOVA          0x10000000u
+#define GFX_RB_OFF        0x00000u    /* 32 KiB ring */
+#define GFX_SQE_OFF       0x08000u    /* 32 KiB */
+#define GFX_SCRATCH_OFF   0x10000u    /* 4 KiB */
+#define GFX_MEM_SIZE      0x11000u
+#define GFX_RB_DWORDS     (0x8000u / 4)
+#define SMMU_GFX_SID      0u
+#define SMMU_GFX_IDX      0u          /* DT gfx3d_user qcom,gpu-offset 0x48000 */
+
+#define ZAP_PA            0x93b15000u /* DT pil_gpu_mem */
+#define ZAP_SIZE          0x2000u
+#define GPU_PAS_ID        13u         /* DT pil_gpu qcom,pas-id */
+
+#define CP_TYPE7_PKT      0x70000000u
+#define CP_NOP            0x10u
+#define CP_MEM_WRITE      0x3du
+#define CP_ME_INIT        0x48u
+#define CP_SET_SECURE_MODE 0x66u
+
+static vm_offset_t gfx_mem, gpu_core;
+static uint64_t gfx_mem_pa;
+static uint32_t rb_wptr;
+
+static void
+core_wr(uint32_t dw, uint32_t v)
+{
+	gpu_wr(gpu_core, dw << 2, v);
+}
+
+static uint32_t
+core_rd(uint32_t dw)
+{
+	return gpu_rd(gpu_core, dw << 2);
+}
+
+static void
+core_wr64(uint32_t dw, uint64_t v)
+{
+	core_wr(dw, (uint32_t)v);
+	core_wr(dw + 1, (uint32_t)(v >> 32));
+}
+
+static void
+gfx_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(gfx_mem_pa + GMU_TABLES + off), len, TRUE);
+}
+
+static uint32_t
+pm4_parity(uint32_t v)
+{
+	return (0x9669u >> (0xfu & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^ (v >> 16) ^
+	    (v >> 20) ^ (v >> 24) ^ (v >> 28)))) & 1u;
+}
+
+static void
+rb_out(uint32_t v)
+{
+	*(volatile uint32_t *)(gfx_mem + GMU_TABLES + GFX_RB_OFF + 4 * rb_wptr) = v;
+	rb_wptr = (rb_wptr + 1) % GFX_RB_DWORDS;
+}
+
+static void
+rb_pkt7(uint32_t opcode, uint32_t cnt)
+{
+	rb_out(CP_TYPE7_PKT | cnt | (pm4_parity(cnt) << 15) | ((opcode & 0x7f) << 16) |
+	    (pm4_parity(opcode) << 23));
+}
+
+/* a6xx_flush + a6xx_idle: publish the ring, wait for the CP to drain it
+ * and for the GPU to go idle (RBBM_STATUS bit 0, CP_AHB_BUSY_CX_MASTER,
+ * does not count). */
+static bool
+rb_kick(const char *what)
+{
+	gfx_sync(GFX_RB_OFF, 0x8000);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	core_wr(0x0807, rb_wptr);                 /* CP_RB_WPTR */
+	bool drained = false, idle = false;
+	for (unsigned i = 0; i < 100000 && !idle; ++i) {
+		drained = drained || core_rd(0x0806) == rb_wptr;   /* CP_RB_RPTR */
+		idle = drained && !(core_rd(0x0210) & ~1u) && !(core_rd(0x0201) & (1u << 23));
+		if (!idle) {
+			delay(1);
+		}
+	}
+	gpu_log("%s: %s (rptr %u wptr %u rbbm_status 0x%08x int0 0x%08x cp_hw_fault 0x%08x)",
+	    what, idle ? "idle" : "TIMEOUT", core_rd(0x0806), rb_wptr, core_rd(0x0210),
+	    core_rd(0x0201), core_rd(0x0821));
+	return idle;
+}
