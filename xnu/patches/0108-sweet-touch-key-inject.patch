--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -116,6 +116,7 @@
 bsd/dev/sweet_gpu.c			standard
 bsd/dev/sweet_wlan.c			standard
 bsd/dev/sweet_tdump_bsd.c		standard
+bsd/dev/sweet_inject.c			standard
 bsd/dev/sweet_irq.c			standard
